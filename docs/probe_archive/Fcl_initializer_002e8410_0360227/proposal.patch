+
+/* The draw provider consumes the four bytes as a value, rather than a packed
+ * integer. Member names agree with the provider's recovered color type. */
+typedef struct {
+    u8 c0;
+    u8 c1;
+    u8 c2;
+    u8 c3;
+} FclDrawColor;
