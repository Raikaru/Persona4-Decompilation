#include "type.h"
typedef s32 s128 __attribute__((vector_size(16)));
static u32 scenario;
#define CHECK(c) do { if (!(c)) native32_failure(__LINE__,scenario,#c); } while(0)
@TYPES@
static Code45RenderState D_00712490[6];
static f32 D_008872F8_abs[1],camera[0x90/4];
static u8 colorValue[4];
static s32 rectangleValue[4];
static u32 saved[6],sets,gets,skies,draws,cameraQueries;
static f32 expectedDepth;
static s32 expectedState;
static s32 func_00457120(void) { ++cameraQueries; return (s32)camera; }
static void get_state(s32 state,void *out) {
    CHECK(expectedState&&gets<6&&state==D_00712490[gets].state);
    CHECK(sets==gets&&skies==0&&draws==0);
    *(s32 *)out=(s32)saved[gets++];
}
static void set_state(s32 state,s32 value) {
    CHECK(expectedState);
    if(sets<6) { CHECK(gets==sets+1&&skies==0&&draws==0); CHECK(state==D_00712490[sets].state&&value==D_00712490[sets].val); }
    else if(sets==6) { CHECK(gets==6&&skies==0&&draws==0); CHECK(state==1&&value==0); }
    else { CHECK(gets==6&&skies==2&&draws==1); CHECK(sets<13&&state==D_00712490[sets-7].state&&value==(s32)saved[sets-7]); }
    ++sets;
}
static void (*D_00887304[])(s32,void *)={get_state};
static void (*D_00887300[])(s32,s32)={set_state};
static void RpSkyRenderStateSet(s32 state,s32 value) {
    CHECK(expectedState&&sets==7&&gets==6&&skies<2);
    CHECK(state==(skies?3:2)&&value==(skies?0x717FB:0x44));++skies;
}
static void draw(s32 primitive,f32 *vertices,s32 count) {
    CHECK(primitive==4&&count==4&&draws==0&&cameraQueries==1);
    CHECK(((u32)vertices&15)==0);
    CHECK(gets==(expectedState?6:0)&&sets==(expectedState?7:0)&&skies==(expectedState?2:0));
    for(u32 i=0;i<4;++i)for(u32 word=0;word<16;++word) {
        f32 expected=0.0f;
        if(word==0)expected=(f32)(rectangleValue[0]+((i&1)?rectangleValue[2]:0));
        if(word==1)expected=(f32)(rectangleValue[1]+((i&2)?rectangleValue[3]:0));
        if(word==2)expected=D_008872F8_abs[0]-expectedDepth;
        if(word==6)expected=1.0f/camera[0x80/4];
        if(word>=8&&word<=11)expected=(f32)colorValue[word-8];
        CHECK(vertices[i*16+word]==expected);
    }
    ++draws;
}
static void (*D_00887310[])(s32,f32 *,s32)={draw};
@PROTOTYPE@
@PROVIDERS@
@CALLERS@
typedef struct { void (*call)(void); f32 depth; s32 state; } Site;
static const Site sites[]={ @SITES@ };
int main(void) {
    for(u32 seed=0;seed<4096;++seed)for(u32 site=0;site<30;++site) {
        ++scenario;sets=gets=skies=draws=cameraQueries=0;
        for(u32 i=0;i<6;++i) { D_00712490[i].state=(s32)i+10;D_00712490[i].val=(s32)(seed+i*11);saved[i]=0xCAFE0000U^(seed+i*7); }
        for(u32 i=0;i<4;++i)colorValue[i]=(u8)(seed+i*37);
        rectangleValue[0]=(s32)seed-2048;rectangleValue[1]=1024-(s32)seed;
        rectangleValue[2]=(s32)(seed%641);rectangleValue[3]=(s32)(seed%449);
        D_008872F8_abs[0]=(seed&1)?65535.0f:128.0f;camera[0x80/4]=(seed&2)?2.0f:0.5f;
        expectedDepth=sites[site].depth;expectedState=sites[site].state;
        sites[site].call();CHECK(draws==1&&cameraQueries==1);
        CHECK(gets==(expectedState?6:0)&&sets==(expectedState?13:0)&&skies==(expectedState?2:0));
    }
    CHECK(scenario==122880);native32_text("122880 layer caller/provider cases passed\n");return 0;
}
