#include "type.h"
#include "Kosaka/k_fldFrame_internal.h"
@ALIAS@
@PROTOTYPE@
_Static_assert(sizeof(void *) == 4, "native32 pointers");
_Static_assert(sizeof(FldAIVec3) == 12, "complete XYZ object");
_Static_assert(__builtin_offsetof(FldAIVec3, x) == 0, "X offset");
_Static_assert(__builtin_offsetof(FldAIVec3, y) == 4, "Y offset");
_Static_assert(__builtin_offsetof(FldAIVec3, z) == 8, "Z offset");
static unsigned scenario, provider_calls;
#define CHECK(c) do { if (!(c)) native32_failure(__LINE__, scenario, #c); } while (0)
static float matrix[64], work[128], actor[128];
static RwV3d anchor, side, direction, expected_input, output;
static RwV3d *expected_pointer;
static float coefficient, length_return;
static RwV3d subtract(RwV3d a, RwV3d b) {
    RwV3d r = {a.x - b.x, a.y - b.y, a.z - b.z}; return r;
}
static float dot(RwV3d a, RwV3d b) {
    return a.z * b.z + a.x * b.x + a.y * b.y;
}
/* This independently spells the storage meaning of each caller construction.
   It is not generated by executing or rewriting the extracted expressions. */
static RwV3d input_for_kind(unsigned kind) {
    RwV3d forward = {matrix[8], matrix[9], matrix[10]};
    RwV3d right = {matrix[0], matrix[1], matrix[2]};
    RwV3d position = {matrix[12], matrix[13], matrix[14]};
    RwV3d target = {work[20], work[21], work[22]};
    RwV3d home = {actor[103], actor[104], actor[105]};
    RwV3d flat_anchor = {anchor.x, 0.0f, anchor.z};
    RwV3d flat_position = {position.x, 0.0f, position.z};
    RwV3d combined = {side.x * coefficient + direction.x,
                     side.y * coefficient + direction.y,
                     side.z * coefficient + direction.z};
    switch (kind) {
    case 0: return forward;
    case 1: return right;
    case 2: return subtract(target, flat_anchor);
    case 3: return subtract(position, anchor);
    case 4: return subtract(target, flat_position);
    case 5: return subtract(position, home);
    case 6: return subtract(anchor, flat_position);
    case 7: return subtract(target, anchor);
    case 8: return subtract(combined, anchor);
    }
    CHECK(0); return target;
}
/* Recording boundary only: deliberately distinct outputs catch swapped/lost
   components. Fractional returns detect integer ABI conversions independently
   of the output vector. This does not implement the retail normalization math. */
__attribute__((noinline)) f32 RwV3dNormalize(RwV3d *out, const RwV3d *in) {
    CHECK(out == expected_pointer && in == expected_pointer && out == in);
    CHECK(in->x == expected_input.x);
    CHECK(in->y == expected_input.y);
    CHECK(in->z == expected_input.z);
    ++provider_calls;
    out->x = output.x;
    out->y = output.y;
    out->z = output.z;
    return length_return;
}
@CALLERS@
@READERS@
static void (*const callers[25])(void) = {
    call_0, call_1, call_2, call_3, call_4, call_5, call_6, call_7,
    call_8, call_9, call_10, call_11, call_12, call_13, call_14, call_15,
    call_16, call_17, call_18, call_19, call_20, call_21, call_22, call_23, call_24
};
int main(void) {
    static const float lengths[] = {0.125f, 0.875f, 1.5f, 3.25f, 17.875f, 255.75f, 0.0f, 1.0f};
    unsigned readbacks = 0;
    int address = (int)actor;
    memcpy(work + 3, &address, 4);
    for (unsigned seed = 0; seed < 4096; ++seed) {
        float a = (float)((int)(seed % 31) - 15) * 0.125f;
        float b = (float)((int)((seed / 31) % 17) - 8) * 0.25f;
        float c = (float)((int)((seed / 527) % 7) - 3) * 0.5f;
        matrix[8] = a + 1.25f; matrix[9] = b - 0.625f; matrix[10] = c + 2.375f;
        matrix[0] = c - 3.125f; matrix[1] = a + 0.875f; matrix[2] = b - 1.75f;
        matrix[12] = a + 17.125f; matrix[13] = b - 21.875f; matrix[14] = c + 7.375f;
        work[20] = b - 8.375f; work[21] = c + 10.125f; work[22] = a - 13.625f;
        actor[103] = c + 24.5f; actor[104] = b - 16.375f; actor[105] = a + 18.625f;
        anchor.x = c + 5.5f; anchor.y = a - 4.125f; anchor.z = b + 6.375f;
        side.x = b - 1.5f; side.y = c + 0.875f; side.z = a - 0.25f;
        direction.x = a + 0.5f; direction.y = b - 1.125f; direction.z = c + 2.75f;
        coefficient = (float)(seed % 5) * 0.375f;
        output.x = a + 0.625f; output.y = b - 1.75f; output.z = c + 3.125f;
        length_return = lengths[seed % 8];
        for (unsigned call = 0; call < 25; ++call) {
            ++scenario; provider_calls = 0; callers[call]();
        }
        readback_2(); readback_7(); readback_8(); readback_9(); readback_10(); readback_11();
        direction_6(); direction_9(); readbacks += 8;
    }
    CHECK(scenario == 102400 && readbacks == 32768);
    native32_text("field_ai_normalize_calls=102400 readback_groups=32768\n");
    return 0;
}
