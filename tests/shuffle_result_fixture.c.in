    const u32 randoms[] = {0, 1, 2047, 2048, 4094, 4095, 0xFFFFFFFFu, 0x80000000u, 0xDEADBEAFu};
    const u32 packed[] = {0, 1, 0x00340000, 0x00FF0001, 0x00800000, 0xABCDFFFFu};
    unsigned stepCases = 0, rollCases = 0;
    for (unsigned kind = 0; kind < 22; ++kind) {
        D_0064E72E[kind][0] = (u8)((kind * 13) % 101);
        D_0064E72E[kind][1] = (u8)((kind * 17 + 60) % 256);
    }
    for (s32 phase = -1; phase <= 20; ++phase) for (unsigned variant = 0; variant < 128; ++variant) {
        ++scenario; memset(&input, 0, sizeof(input));
        input.phase = phase; input.choice = (s32)(variant % 5) - 1; input.busy = (variant >> 4) & 1;
        input.animation = (variant & 1) ? -1 : 0; input.effect = (variant >> 1) & 1; input.task = (variant >> 2) & 1;
        input.reveal = (variant >> 3) & 1; input.slide = (variant >> 5) & 1; input.extra = (s32)(variant % 5) - 2;
        input.initialFlags = (variant * 13 + phase) & 31; input.mutation = variant & 15;
        input.random[0] = randoms[variant % 9]; input.random[1] = randoms[(variant * 5 + 3) % 9]; input.random[2] = 4095;
        input.lookup = variant % 3 == 0 ? 0 : variant % 3 == 1 ? 0x10000 : 0x123456;
        input.timer = timers[variant % 9]; input.step = steps[(variant / 2) % 6]; input.persona = personas[variant % 5];
        input.capacity = (u16)(3 + (variant % 3)); input.count = (u16)(3 + ((variant / 3) % 3));
        input.contextFlags = (u16)(variant * 0x1111); input.spins = (s32)(variant % 5) - 1;
        input.upright = (variant / 2) % 3 == 0 ? 0 : (variant & 2 ? -1 : 1); input.override = (s32)(variant % 3);
        input.packed = (s32)packed[variant % 6]; input.selected = variant % 4; input.kind = variant % 22;
        compareStep(); ++stepCases;
