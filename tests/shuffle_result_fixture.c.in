    prepare(1); expectedResult = modelStep();
    CHECK(result == expectedResult && logCount == count && randomIndex == randoms && flags == changedFlags);
    CHECK(memcmp(observedEvents, expectedEvents, count * sizeof(Event)) == 0);
    CHECK(memcmp(observedWork.bytes + 4, expectedWork.bytes + 4, 0x90) == 0);
    CHECK(memcmp(observedContext.bytes, expectedContext.bytes, 0x20000) == 0);
