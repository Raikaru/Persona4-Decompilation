    *(u8 **)work = context; W16(0x10) = input.persona; work[0x12] = input.kind; W32(0x18) = input.phase;
    W16(0x1C) = input.timer; W16(0x1E) = input.step; W32(0x20) = input.spins; work[0x24] = 17;
    W32(0x28) = input.upright; W32(0x2C) = input.override; W32(0x30) = input.packed;
    C32(0x1F294) = 0x123410; C32(0x1F29C) = 0x234520; C32(0x1F2A0) = (scenario & 4) ? 0x345630 : 0;
    C32(0x1F2A4) = 0x456740; C32(0x1F2A8) = 0x567850; C32(0x1F2DC) = 0x678960;
    C32(0x1F308) = input.selected; C16(0x1F2F4) = input.contextFlags;
