static void prepare(unsigned expected) {
    work = expected ? expectedWork.bytes : observedWork.bytes;
    context = expected ? expectedContext.bytes : observedContext.bytes;
    events = expected ? expectedEvents : observedEvents;
    modelMode = expected; flags = input.initialFlags; logCount = randomIndex = 0;
