       forced-threshold paths. The reference comparison uses integer math. */
    memset(&input, 0, sizeof(input)); input.kind = 0;
    for (unsigned kind = 0; kind < 22; ++kind) for (unsigned column = 0; column < 2; ++column)
    for (unsigned value = 0; value < 4096; ++value) {
        s32 a, b; u32 count, changedFlags, randomCount;
        ++scenario; input.initialFlags = (value & 8) ? 7 : 1; input.extra = column ? (value & 1 ? 2 : -2) : 0;
        input.random[0] = value; input.mutation = (value & 1) ? 2 : 0;
        work = observedWork.bytes; events = observedEvents; flags = input.initialFlags; logCount = randomIndex = 0; work[0x12] = kind;
        a = shuffleResultRoll(kind); count = logCount; changedFlags = flags; randomCount = randomIndex;
        work = expectedWork.bytes; events = expectedEvents; flags = input.initialFlags; logCount = randomIndex = 0; work[0x12] = kind;
        b = modelRoll(kind);
        CHECK(a == b && count == logCount && changedFlags == flags && randomCount == randomIndex);
        CHECK(memcmp(observedEvents, expectedEvents, count * sizeof(Event)) == 0); ++rollCases;
    }
    native32_text("shuffle-result state scenarios: "); native32_number(stepCases);
    native32_text("; roll scenarios: "); native32_number(rollCases); native32_text("\n");
    return 0;
}
