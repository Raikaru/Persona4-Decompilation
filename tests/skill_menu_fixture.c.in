}
void func_00113730(s16 *d){d[0]=d[1]=d[2]=0;EV(5,0);}
static void descriptor(u32 id,Vec2f p,s32 alpha,void*ptr,s32 mode,f32 depth){
 SkillMenuDescriptor*d=ptr;u32 *v=(u32*)&d->payload;CHECK(d->kind==1);CHECK(d->style>=2&&d->style<=4);CHECK(d->flags==0||d->flags==1);
 EV(id,bits(p.x),bits(p.y),alpha,d->kind,d->style,d->flags,v[0],v[1],v[2],mode,bits(depth));mutate();
}
void func_00113790(Vec2f p,u8 alpha,void*data,s32 mode,f32 depth){descriptor(6,p,alpha,data,mode,depth);}
void func_0013b420(void *work,Vec2f p,s32 alpha,void*data){CHECK(work==&M);overlayCalls++;descriptor(7,p,alpha,data,0,0.0f);}
void func_0013ad40(u8 *work,s32 row,s32 column){CHECK(work==(u8*)&M);CHECK(row>=0&&row<M.partyCount);CHECK(column==0||column==3);EV(8,row,column);mutate();}
s32 func_0013ac30(u16 skill){s32 kind=(s32)(skill%11);s32 result=kind?43+(kind-1)%9:-1;EV(9,skill,result);mutate();return result;}
void func_0034f9d0(Vec2f p,f32 depth,u8 alpha,s32 mode,s32 texture){EV(10,bits(p.x),bits(p.y),bits(depth),alpha,mode,texture);mutate();}
static void initialize(void){
 static const u16 flags[]={1,2,8,0x10,0x20,0x40,0x80,0x200,0x400,0x800,0x1000,0x2000};
 static const s16 counts[]={0,1,5,6,7,12,20,96};static const u8 alphas[]={0,1,127,254,255};
 memset(&M,0,sizeof(M));seed=scenario+1;mutationMode=scenario<4096?0:1+((scenario-4096)%15);
 for(u32 n=0;n<4;n++){storage.pre[n]=0xAAF10000+n;storage.post[n]=0xAAF20000+n;}
 for(u32 i=0;i<12;i++)if((scenario&4095)&(1u<<i))M.visible|=flags[i];
 if(scenario>=4096)M.visible=(scenario%3)?0x3EFB:0x30A8;
 M.alpha=alphas[(scenario/7)%5];M.x=((s32)(scenario%31)-15)*0.25f;M.y=((s32)(scenario%29)-14)*0.5f;
 M.background=(scenario%5)?1+(scenario%35):0;M.partyCount=(s16)((scenario/3)%5);M.skillCount=counts[(scenario/5)%8];
 M.scrollRow=M.skillCount>6?(s16)((scenario/11)%((u32)M.skillCount-5)):0;M.selectedRow=(s16)((scenario/13)%6);
 if(M.scrollRow+M.selectedRow>=96)M.selectedRow=0;
 M.footerMode=(s16)(scenario%3);M.footer.handle=0x20000+scenario*4;
 for(u32 i=0;i<96;i++){M.skills[i].fields.id=(s16)(i+1);M.skills[i].fields.key=(u16)((scenario+i)%41);M.skills[i].fields.a=(f32)i+0.5f;M.skills[i].fields.b=-(f32)i-0.25f;}
 for(u32 i=0;i<68;i++){M.animation[i].x=((s32)(random32()%127)-63)*0.125f;M.animation[i].y=((s32)(random32()%127)-63)*0.125f;M.animation[i].alpha=alphas[(scenario+i)%5];M.animation[i].scaleX=(u16)(1+random32()%1000);M.animation[i].scaleY=(u16)(1+random32()%1000);}
 for(u32 i=0;i<60;i++)M.sprites[i]=(void*)(0x10000+i*4);
 for(u32 i=0;i<28;i++){SkillDecoration*t=(SkillDecoration*)D_005ED790+i;t->x=(f32)(i*7)+0.5f;t->y=-(f32)(i*3)-0.25f;t->width=1.0f+(f32)(i%11)*0.25f;t->height=1.0f+(f32)(i%13)*0.5f;t->paletteIndex=(s32)(i&1);}
 for(u32 c=0;c<4;c++){D_00762DC0[c]=(u8)(240+c);D_00762DC0[c+4]=(u8)(90+c);D_0064B2E0[c]=(u8)(10+c);D_0064B2E4[c]=(u8)(40+c);D_0064B2E8[c]=(u8)(70+c);D_0064B2EC[c]=(u8)(100+c);D_0064B2F4[c]=(u8)(130+c);}
}
int main(void){
 CHECK(sizeof(SkillMenuView)==0x1338);CHECK(sizeof(SkillMenuAnimation)==0x30);CHECK(sizeof(SkillMenuDescriptor)==20);CHECK(sizeof(SkillDecoration)==20);
 CHECK((u32)&M.animation-(u32)&M==0x584);CHECK((u32)&M.sprites-(u32)&M==0x1244);CHECK((u32)&M.skills-(u32)&M==0x100);
 for(scenario=0;scenario<6144;scenario++){
  initialize();words=calls=0;u32 beforeHash=hash(&M,sizeof(M));if((M.visible&0x98)==0x98&&M.selectedRow+M.scrollRow<M.skillCount)selectionSkipCases++;
  func_00138bf0((u8*)&M);
  if(mutationMode==0)CHECK(beforeHash==hash(&M,sizeof(M)));
  for(u32 n=0;n<4;n++){CHECK(storage.pre[n]==0xAAF10000+n);CHECK(storage.post[n]==0xAAF20000+n);}
  EV(250,hash(&M,sizeof(M)),hash(D_00762DC0,8),hash(D_0064B2E0,4),hash(D_0064B2EC,4));
  u32 header[]={scenario,words};feed((const char*)header,sizeof(header));feed((const char*)trace,words*4);
 }
 u32 summary[]={decorationCalls,overlayCalls,selectionSkipCases,scrollCases,highlightIcons,regularIcons};feed((const char*)summary,sizeof(summary));
 CHECK(decorationCalls==81920 && overlayCalls==3597 && selectionSkipCases==1434);
 CHECK(scrollCases==4096 && highlightIcons==431 && regularIcons==16767);
 CHECK(streamHash==0xD1EA1731u);
