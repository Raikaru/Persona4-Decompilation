static u32 random32(void){seed=seed*1664525+1013904223;return seed;}
static u32 hash(const void *data,u32 size){const u8*p=data;u32 h=2166136261u;while(size--)h=(h^*p++)*16777619u;return h;}
static void record(u32 id,const u32 *data,u32 count){CHECK(words+count+2<8192);trace[words++]=id;trace[words++]=count;for(u32 n=0;n<count;n++)trace[words++]=data[n];calls++;CHECK(calls<512);}
#define EV(id,...) do{const u32 args[]={__VA_ARGS__};record(id,args,sizeof(args)/4);}while(0)
static void mutate(void){
 if(mutationMode&1){M.x+=0.25f;M.y-=0.5f;M.alpha=(u8)(M.alpha+7);}
 if(mutationMode&2){u32 r=(calls+scenario)%38;M.animation[r].x+=0.125f;M.animation[r].y-=0.25f;M.animation[r].alpha=(u8)(M.animation[r].alpha+11);}
 if(mutationMode&4){M.sprites[18]=(void*)(0x80000+calls*4);D_0064B2E0[0]++;D_0064B2EC[2]++;D_00762DC0[0]++;}
 if(mutationMode&8){if(calls%7==0)M.visible^=0xE80;if(calls%5==0)M.selectedRow=(s16)((M.selectedRow+1)%6);M.scrollRow=(s16)((M.scrollRow+1)%5);M.skillCount=(s16)(6+(calls%14));}
}
void func_0034f1e0(void){EV(1,0);mutate();}
void func_0034c270(Vec2f p,s32 alpha,s32 background,f32 depth){CHECK(background!=0);EV(2,bits(p.x),bits(p.y),alpha,background,bits(depth));mutate();}
void func_0034f2e0(void *sprite,f32 x,f32 y,u8 r,u8 g,u8 b,u8 alpha){
