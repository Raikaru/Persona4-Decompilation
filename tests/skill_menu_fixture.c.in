static struct {u32 pre[4];SkillMenuView menu;u32 post[4];} storage __attribute__((aligned(16)));
/* The golden stream digest was established by both O0/O2 executions of the
   retail-repaired pre-allocation reconstruction. Eight behavioral
   mutants must change this result; the target byte verifier is a separate gate. */
static u32 scenario,calls,words,mutationMode,seed,trace[8192];
static u32 streamHash = 2166136261u;
static void feed(const char *data, u32 size) {
    for (u32 i = 0; i < size; ++i) streamHash = (streamHash ^ (u8)data[i]) * 16777619u;
}
static u32 decorationCalls,overlayCalls,selectionSkipCases,scrollCases,highlightIcons,regularIcons;
u8 D_00762DC0[8],D_005ED790[560] __attribute__((aligned(16)));
