}
void func_0034f320(u8 *sprite,f32 x,f32 y,f32 depth,u8 r,u8 g,u8 b,u8 alpha,u16 width,u16 height,s16 angle,f32 scale,s16 mode){
 EV(4,(u32)sprite,bits(x),bits(y),bits(depth),r,g,b,alpha,width,height,(u32)angle,bits(scale),(u32)mode);
 if((u32)sprite==0x10000+42*4)decorationCalls++;
 if((u32)sprite>=0x10000+43*4&&(u32)sprite<=0x10000+51*4){if(r==D_0064B2EC[0]&&g==D_0064B2EC[1]&&b==D_0064B2EC[2])highlightIcons++;else regularIcons++;}
