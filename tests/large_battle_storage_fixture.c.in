#include "battle_approach_action_fixture.h"
%%HIT_TYPE%%
typedef char HitSize[sizeof(LargeBattleHitResult)==0x20?1:-1];
typedef char HitBase[__builtin_offsetof(BtlActionSequence,hits)==0xf0?1:-1];
typedef char HitMotion[__builtin_offsetof(LargeBattleHitResult,motion)==0x1c?1:-1];
typedef char HitFlags[__builtin_offsetof(LargeBattleHitResult,flags)==0x1e?1:-1];
static BtlActionSequence action,target;
static u8 unit[0xb00], packet[0x90];
static const void *expectedResult;
static u8 snapshot[sizeof target];
static unsigned recorded;
static void *func_001f36e0(s32 source,s32 destination,const void *result,u16 effect,u16 flags)
{
    CHECK(source==(s32)&action && destination==(s32)&target);
    CHECK(effect==0x402 && flags==0x1234 && result==expectedResult);
