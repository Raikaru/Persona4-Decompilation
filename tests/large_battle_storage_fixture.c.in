int main(void)
{
    memset(&action,0xa5,sizeof action);memset(&target,0x3c,sizeof target);
    action.unit=unit;target.unit=unit;action.skill=0x4567;
    target.effect=0x402;target.targetFlags=0x1234;
    for(unsigned motion=0;motion<256;++motion) {
        for(unsigned i=0;i<24;++i) {
            BtlActionHitResult *h=&target.hits[i];
            h->hpDelta=0x3141592+(s32)i;h->spDelta=-0x10203-(s32)i;
            h->addedStatus=0x80000000u|(0x1234u*i);h->removedStatus=0x54321000u+i;
            h->field10=0xc0010000u+i;h->field14=-10000+(s32)i;
            h->hpTransfer=(s16)(-32000+i);h->spTransfer=(s16)(31000-i);
            h->motion=(s8)(motion+i);h->field1d=(u8)(i+0x40);h->flags=(u16)(0xa5a5u^i);
        }
        memcpy(snapshot,&target,sizeof target);
        for(unsigned i=0;i<24;++i) {
            expectedResult=&target.hits[i];recorded=0;
            small_hit(i); CHECK(recorded==2); large_hit(i);
            CHECK(memcmp(snapshot,&target,sizeof target)==0);++scenario;
        }
    }
    native32_text("6144 hit record cases passed\n");return 0;
}
