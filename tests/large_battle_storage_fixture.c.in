    CHECK(hit->flags==target.hits[index].flags);
    CHECK(hit->addedStatus==target.hits[index].addedStatus);
    %%SMALL_RESULT_SETUP%%
    CHECK(sp1F0->hpDelta==target.hits[index].hpDelta);
    CHECK((void *)sp1F0==expectedResult && (void *)temp_2_48==expectedResult);
    CHECK(%%RESULT_CALL%%==packet);
    CHECK(%%DISPLAY_CALL%%==packet);
}
static void large_hit(u16 index)
{
    s32 *temp_18=(s32 *)&target;
    u16 sp3B0=index;
    s32 temp_2_95,sp120,sp110;
    s8 *hitMotion;
    u8 *temp_2_96;
    s32 *temp_2_108,*sp240;
