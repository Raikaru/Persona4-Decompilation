}
static u8 *func_00201de0(s32 source,s32 destination,s32 id,u16 effect,u16 flags,
                        u16 index,u16 count,const void *result,u16 mode)
{
    CHECK(source==(s32)unit && destination==(s32)unit && id==0x4567);
    CHECK(effect==0x402 && flags==0x1234 && index==0 && count==1 && mode==0);
    CHECK(result==expectedResult && memcmp(result,expectedResult,0x20)==0);
    ++recorded; return packet;
}
static void small_hit(u16 index)
{
    s64 *temp_18=(s64 *)&target,*arg0=(s64 *)&action,*var_22_3=(s64 *)&target;
    u8 *temp_19=unit;
    u16 sp1D0=index;
    LargeBattleHitResult *hit,*temp_2_48,*sp1F0;
    s8 temp_2_27;
    %%SMALL_SELECT%%
    CHECK((void *)hit==expectedResult);
    %%MOTION%%
