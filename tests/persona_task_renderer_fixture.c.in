static void prepare(unsigned index) {
 static const unsigned visibility[]={0x10,0x20,0x40,0x80,0x100,0x200,0x400,0x800,0x4000,0x8000};
 static const s16 frames[]={-1,0,18,19,20,98,99,100,101};
 unsigned i;
 memset(workStorage,0x6D,sizeof(workStorage)); activeWork=(PersonaRenderWork *)workStorage;
 activeWork->controllerAddress=(s32)&controller;controller=(index&1)?4:0;
 activeWork->flags=9;
 for(i=0;i<10;i++) if(index&(1u<<i)) activeWork->flags|=visibility[i];
 activeWork->flags |= (index&1?2:4) | (index&2?0x1000:0x2000);
 if(index&4) activeWork->flags|=0x10000;
 if(index&8) activeWork->flags|=0x200000;
 if(index&16) activeWork->flags|=0x80000;
 if(index&32) activeWork->flags|=0x800000;
 if(index&64) activeWork->flags|=0x100000;
 if(index&128) activeWork->flags|=0x40000;
 if(index&256) activeWork->flags|=0x400000;
 activeWork->model=model;activeWork->alpha=(u8)(index*67);
 activeWork->openingFrame=frames[index%9];activeWork->selectionFrame=frames[(index+1)%9];
 activeWork->comparisonFrame=frames[(index+2)%9];activeWork->skillFrame=frames[(index+3)%9];
 activeWork->revealFrame=frames[(index+4)%9];activeWork->meterPhase=(s16)(index-512);
 activeWork->selectedSkill=index%10-1;activeWork->selectedSkillFade=0.75f;activeWork->overlayId=123;
 activeWork->selectionPosition.x=-73.5f;activeWork->selectionPosition.y=42.25f;
 for(i=0;i<4;i++) activeWork->sprites[i]=index%31==0?0:400+i;
 for(i=0;i<10;i++) {activeWork->channels[i].current.x=-61.5f+7*i;activeWork->channels[i].current.y=9.25f-3*i;activeWork->channels[i].alpha=(u8)(index*19+i*23);}
 for(i=0;i<2;i++) {activeWork->persona[i].category=(index%5)?(13+i):0;for(unsigned j=0;j<5;j++){activeWork->persona[i].values[j]=20+j*13;activeWork->persona[i].added[j]=(index&1)?j:0;}}
 query=index;memcpy(savedWork,workStorage,sizeof(workStorage));
}
static void verifyMeterContract(void) {
 Vec2f point = {12.5f, 20.25f};
 used=0;func_00116d40(point,0.0f,254,60,11,0,444);
 CHECK(used==78);CHECK(trace[0]==0x44b610);CHECK(trace[1]==0);
 /* Three sprites, two rectangles and the final end cap. */
 CHECK(trace[2]==0x46d4c0);CHECK(trace[5]==0x3D);CHECK(trace[8]==1);
 CHECK(trace[14]==0x46d4c0);CHECK(trace[17]==0x3E);
 CHECK(trace[26]==0x46d4c0);CHECK(trace[29]==0x3F);CHECK(trace[32]==1);
 CHECK(trace[33]==140);CHECK(trace[34]==140);CHECK(trace[35]==140);
 CHECK(trace[41]==0x45d6e0);CHECK(trace[45]==254);
 CHECK(trace[46]==122);CHECK(trace[47]==24);CHECK(trace[48]==104);CHECK(trace[49]==9);
 CHECK(trace[55]==0x45d6e0);CHECK(trace[59]==222);
 CHECK(trace[60]==122);CHECK(trace[61]==25);CHECK(trace[62]==22);CHECK(trace[63]==7);
 CHECK(trace[66]==0x46d4c0);CHECK(trace[69]==0x40);CHECK(trace[72]==33);
}
int main(void) {
 unsigned expectedUsed,i;
 for(scenario=0;scenario<2048;scenario++) {
  prepare(scenario&1023); mutationIndex=scenario<1024?0:1+scenario%9;
  used=callbackIndex=0;referencePersonaTaskRenderer((u8 *)1,workStorage);
  expectedUsed=used;memcpy(expectedTrace,trace,used*4);memcpy(expectedWork,workStorage,sizeof(workStorage));
  memcpy(workStorage,savedWork,sizeof(workStorage));used=callbackIndex=0;
  func_00119e10((u8 *)1,workStorage);
  CHECK(used==expectedUsed);CHECK(memcmp(trace,expectedTrace,used*4)==0);CHECK(memcmp(workStorage,expectedWork,sizeof(workStorage))==0);
 }
 /* The two entry gates each prevent every write and external call. */
 for(i=0;i<3;i++) {prepare(0);activeWork->flags=i==0?0:i==1?1:8;memcpy(savedWork,workStorage,sizeof(workStorage));used=0;func_00119e10(0,workStorage);CHECK(used==0);CHECK(memcmp(savedWork,workStorage,sizeof(workStorage))==0);}
 /* This counter really advances twice, with a cap applied each time. */
 prepare(0);activeWork->flags=9|0x800;activeWork->selectionFrame=98;mutationIndex=0;used=callbackIndex=0;func_00119e10(0,workStorage);CHECK(activeWork->selectionFrame==100);
 verifyMeterContract();
 native32_text("persona-task cases: 2052; callback traces, alpha and meter provider verified\n");return 0;
}
