static void reference_edit(ControllerEntry *item, s32 direction, s32 amount) {
    if (!item) return;
    if (item->type == 2) item->integerValue = item->integerValue != 1;
    if (item->type == 3) {
        item->integerValue = (s32)((u32)item->integerValue + (u32)(direction * amount));
        if (direction > 0 && item->integerValue > item->maximum) item->integerValue = item->minimum;
        if (direction < 0 && item->integerValue < item->minimum) item->integerValue = item->maximum;
    }
    if (item->type == 4) {
        f32 delta = D_00761514 * (f32)amount;
        if (direction > 0) {
            item->realValue += delta;
            if (!(item->realValue <= (f32)item->maximum)) item->realValue = (f32)item->minimum;
        } else {
            item->realValue -= delta;
            if (item->realValue < (f32)item->minimum) item->realValue = (f32)item->maximum;
        }
    }
}
