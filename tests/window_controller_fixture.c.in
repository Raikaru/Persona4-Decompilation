    for (s32 flags = 0; flags < 8; ++flags) for (s32 mode = 0; mode < 4; ++mode) {
        defaults(); testCase.flags = flags; testCase.analogX = analog[x]; testCase.analogY = analog[y];
        testCase.mutation = mode == 1 ? 4 : mode == 2 ? 8 : mode == 3 ? 24 : 0;
        testCase.action = 0x2000; testCase.inputResult = mode == 3; run_case();
    }
    for (s32 mutation = 0; mutation < 256; ++mutation) for (s32 ready = 0; ready < 2; ++ready) {
        defaults(); testCase.mutation = mutation; testCase.ready = ready; testCase.wide = 1; testCase.valueCase = 1;
        testCase.entryType = mutation % 6; testCase.confirm = 0x40; testCase.argument = ready;
        testCase.held = mutation & 15; testCase.flags = (mutation >> 4) & 7;
        testCase.action = events[(mutation >> 2) & 3]; testCase.analogX = 79; testCase.analogY = 177; run_case();
