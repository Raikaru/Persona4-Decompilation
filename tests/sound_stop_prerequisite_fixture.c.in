#include "type.h"
static u32 scenario;
#define CHECK(c) do { if (!(c)) native32_failure(__LINE__, scenario, #c); } while (0)
static u8 battleStorage[0x1000] __attribute__((aligned(16)));
static u8 expected[sizeof(battleStorage)];
static u8 *iGpffffb3ac = battleStorage + 0x10;
static u32 audioCount, expectedFlags, taskBits;

void func_00212210(s32 task)
{
    CHECK(audioCount == 0);
    CHECK((u32)task == taskBits);
    CHECK(*(u32 *)(iGpffffb3ac + 0xc) == expectedFlags);
    CHECK(memcmp(battleStorage, expected, sizeof(battleStorage)) == 0);
    ++audioCount;
}
void func_0045af60(s32 first, s32 second, s32 third, s32 fourth)
{
    CHECK(audioCount == 1);
    CHECK(first == 1 && second == 0xf && third == 2 && fourth == 0x13);
    CHECK(*(u32 *)(iGpffffb3ac + 0xc) == expectedFlags);
    CHECK(memcmp(battleStorage, expected, sizeof(battleStorage)) == 0);
    ++audioCount;
}

%%SOUND_STOP%%

static void run(u32 flags, u32 task)
{
    ++scenario;
    memset(battleStorage, (u8)(scenario * 43u), sizeof(battleStorage));
    memcpy(iGpffffb3ac + 0xc, &flags, 4);
    memcpy(iGpffffb3ac + 0xdd4, &task, 4);
    memcpy(expected, battleStorage, sizeof(battleStorage));
    expectedFlags = flags & 0xffffefffu;
    memcpy(expected + 0x1c, &expectedFlags, 4);
    taskBits = task;
    audioCount = 0;
    func_001eb7f0();
    CHECK(audioCount == ((flags & 0x1000u) ? 2u : 0u));
    CHECK(memcmp(battleStorage, expected, sizeof(battleStorage)) == 0);
    /* Clearing the flag makes a second stop a complete no-op. */
    func_001eb7f0();
    CHECK(audioCount == ((flags & 0x1000u) ? 2u : 0u));
    CHECK(memcmp(battleStorage, expected, sizeof(battleStorage)) == 0);
}
int main(void)
{
    const u32 tasks[] = {0, 1, 0x7fffffff, 0x80000000, 0xffffffff, 0xa5732c91};
    const u32 flags[] = {0, 1, 0x80, 0x800, 0x1000, 0x2000, 0x4000, 0x10000,
                         0x20000000, 0x80000000, 0xffffffff, 0xffffefff};
    u32 random = 0x7a95314d;
    for (u32 f = 0; f < 12; ++f)
        for (u32 t = 0; t < 6; ++t) {
            run(flags[f] & ~0x1000u, tasks[t]);
            run(flags[f] | 0x1000u, tasks[t]);
        }
    /* Every 32-bit flag is independently tested set and clear, with and
     * without the sound flag, across all full-word task patterns. */
    for (u32 bit = 0; bit < 32; ++bit)
        for (u32 t = 0; t < 6; ++t) {
            run(1u << bit, tasks[t]);
            run((1u << bit) | 0x1000u, tasks[t]);
            run(~(1u << bit), tasks[t]);
            run(~(1u << bit) & ~0x1000u, tasks[t]);
        }
    for (u32 i = 0; i < 256; ++i) {
        random = random * 1664525u + 1013904223u;
        run(random & ~0x1000u, tasks[i % 6]);
        run(random | 0x1000u, tasks[i % 6]);
    }
    CHECK(scenario == 1424);
    native32_text("1424 sound flag/task cases; 2848 exact stop calls passed\n");
    return 0;
}
