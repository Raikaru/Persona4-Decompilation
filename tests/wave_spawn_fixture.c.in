static void check_normal(unsigned i,unsigned global,unsigned mode) {
    f32 q=.7071067811865475f;
    WaveSpawnState e;
    e.direction[0]=0;e.direction[1]=global?0:1;e.direction[2]=global?1:0;
    e.waveDirection[0]=q;e.waveDirection[1]=global?q:0;e.waveDirection[2]=global?0:q;
    e.phase=6;e.previousSine=3;e.amplitude=1.75f;e.amplitudeStep=.525f;
    e.phaseStep=.35f;e.speed=3.5f;e.sizeScale=.9375f;
    e.angleOffset=mode==1?6:0;e.angleScale=mode==2?1:((randomWord&1)&&mode==1?-.875f:.875f);
    {
        f32 actual[15], expected[15];
        memcpy(actual,&states[i],sizeof(actual));
        memcpy(expected,&e,sizeof(expected));
        for(unsigned k=0;k<15;k++) CHECK(near(actual[k],expected[k]));
    }
    SpawnParticle p=originalParticles[i];
    for(unsigned k=0;k<3;k++)p.position.lane[k]=e.waveDirection[k]*3+(global?parameters.position.lane[k]:0);
    p.position.lane[3]=global?7:0;p.age=0;p.color=0xA1B2C3D4;p.size=1.875f;
    p.angle=3*e.angleScale+e.angleOffset;
    same_vector(&p.position,&particles[i].position);
    CHECK(!memcmp((u8 *)&p+16,(u8 *)&particles[i]+16,16));
    same_vector(&previousPosition[i],&p.position);CHECK(attributeAge[i]==0);
}
