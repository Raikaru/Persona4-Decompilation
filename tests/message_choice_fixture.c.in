typedef union ChoiceWork {
    u32 words[6];
    struct {
        u32 flags;
        s16 waitCount;
        s16 animationCount;
        u8 remaining[16];
    } fields;
} ChoiceWork;
static struct {
    u32 before;
    ChoiceWork work;
    u32 after;
} choiceState;
/* The three retail symbols alias one 24-byte allocation. */
#define D_00882060 (choiceState.work.words)
#define D_00882064 (&choiceState.work.fields.waitCount)
#define D_00882066 (&choiceState.work.fields.animationCount)

u8 D_00796490[16];
char D_0063BFC0[16];
f32 iGpffff8094 = 1.5707964f;
f32 iGpffff81d8 = 0.1f;
s32 iGpffffb4d8, iGpffffb4dc;

static unsigned scenario, enabled, backgroundCalls, arrowCalls, bitCalls;
static unsigned visibleCalls, getterCalls, sineCalls, phase;
static s32 counterAfterGetter, counterAfterDraw;
static const s32 unchangedCounter = 65536;
#define CHECK(x) do { if (!(x)) native32_failure(__LINE__, scenario, #x); } while (0)

/* INSERT_CONTROLLER */

s32 func_00278110(s32 handle) { CHECK(handle == 17); return 0; }
void func_00278170(void *handle, u32 mask) {
    static const u32 masks[] = {0x100000, 0x400000, 0x800000};
    CHECK((u32)handle == 17); CHECK(bitCalls < 3); CHECK(mask == masks[bitCalls++]);
}
s32 func_0027bec0(s32 handle) { CHECK(handle == 17); ++visibleCalls; return enabled; }
s32 func_00277070(s32 handle) { CHECK(handle == 17); ++getterCalls; return 1; }
s32 func_00279010(s32 handle) {
    CHECK(handle == 17); ++getterCalls;
    if (counterAfterGetter != unchangedCounter) D_00882066[0] = (s16)counterAfterGetter;
    return 0x10004; /* The controller must narrow the count to a signed halfword. */
}
s32 func_00278fb0(void *handle) { CHECK((u32)handle == 17); return 0; }
s32 func_00278ff0(void *handle) { CHECK((u32)handle == 17); return 0; }
f32 sinf(f32 argument) { ++sineCalls; return 0.5f; }
void func_00366380(s32 x, s32 y, f32 depth, s32 width, s32 height,
                   s32 color, s32 alpha, s32 mode, s32 offsetX, s16 offsetY,
                   void *queue, f32 rotation, f32 scaleX, f32 scaleY) {
    CHECK(depth == 0.0f && width == 448 && color == 0x1b1811);
    CHECK(alpha == 229 && mode == 1 && offsetX == 0 && offsetY == 0);
    CHECK(queue == D_00796490 && rotation == 0.0f && scaleX == 1.0f && scaleY == 1.0f);
    if (phase == 11) { CHECK(x == -255 && y == 206 && height == 179); }
    else if (phase == 12) { CHECK(x == -5 && y == 206 && height == 179); }
    else { CHECK(phase == 13); CHECK(x == -5 && y == 221 && height == 134); }
    ++backgroundCalls;
    if (counterAfterDraw != unchangedCounter) D_00882066[0] = (s16)counterAfterDraw;
}
void func_0025ec90(f32 x, f32 y, f32 depth, s32 color, u8 alpha, s32 slot,
                   void *sprite, s32 mode, void *queue) {
    CHECK(x == (slot == 0 ? 23.0f : 407.0f)); CHECK(y == 243.0f && depth == 0.0f);
    CHECK(color == 0xffae20 && alpha == 255 && mode == 1);
    CHECK((u32)sprite == (u32)iGpffffb4d8 && queue == D_00796490); ++arrowCalls;
}
s32 func_0025ecd0(f32 x, f32 y, f32 depth, s32 color, u8 alpha, s32 slot,
                   void *sprite, s32 mode, s16 offsetX, s16 offsetY,
                   f32 rotation, f32 scaleX, f32 scaleY, void *queue) {
    CHECK(x == (slot == 0 ? 23.0f : 407.0f)); CHECK(depth == 0.0f);
    CHECK(color == 0xffae20 && alpha == 255 && mode == 1);
    CHECK(offsetX == 0 && offsetY == 0 && rotation == 0.0f && scaleX == 1.0f);
    CHECK((u32)sprite == (u32)iGpffffb4d8 && queue == D_00796490);
