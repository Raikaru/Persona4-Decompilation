static void reset(unsigned nextPhase) {
    memset(&choiceState, 0, sizeof choiceState);
    choiceState.before = 0x12345678; choiceState.after = 0x76543210;
    enabled = 1; phase = nextPhase;
    backgroundCalls = arrowCalls = bitCalls = visibleCalls = getterCalls = sineCalls = 0;
    counterAfterGetter = counterAfterDraw = unchangedCounter;
    iGpffffb4d8 = 0x1230; iGpffffb4dc = 0x4560; ++scenario;
}
static void checkSentinels(void) {
    CHECK(sizeof(ChoiceWork) == 24);
    CHECK(choiceState.before == 0x12345678 && choiceState.after == 0x76543210);
}

int main(void) {
    static const s16 waitValues[] = {-32768, -1, 0, 32766, 32767};
    static const s16 closeValues[] = {-2, 0, 1, 6, 7, 8, 32767};
    reset(0); memset(&choiceState.work, 0x5a, 24);
    CHECK(func_00282250((u8 *)17, 0) == 0); CHECK(bitCalls == 3);
    for (unsigned i = 0; i < 6; ++i) CHECK(choiceState.work.words[i] == 0);
    checkSentinels();
    for (unsigned i = 0; i < 5; ++i) for (unsigned active = 0; active < 2; ++active) {
        s16 next = (s16)((u16)waitValues[i] + 1u);
        reset(4); enabled = active; D_00882060[0] = 0x80000002u; D_00882064[0] = waitValues[i];
        CHECK(func_00282250((u8 *)17, 4) == (active && next >= 0));
        CHECK(visibleCalls == 1 && getterCalls == 0 && backgroundCalls == 0);
        CHECK(D_00882064[0] == (active ? (next >= 0 ? 0 : next) : waitValues[i]));
        CHECK(D_00882060[0] == (active && next >= 0 ? 0x80000000u : 0x80000002u));
        checkSentinels();
    }
    for (unsigned loaded = 0; loaded < 4; ++loaded) {
        reset(12); iGpffffb4d8 = loaded & 1 ? 0x1230 : 0; iGpffffb4dc = loaded & 2 ? 0x4560 : 0;
        CHECK(func_00282250((u8 *)17, 12) == 1);
        CHECK(visibleCalls == 1 && backgroundCalls == (loaded == 3));
        CHECK(getterCalls == (loaded == 3 ? 2u : 0u));
        CHECK(arrowCalls == (loaded == 3 ? 2u : 0u)); checkSentinels();
    }
    for (unsigned i = 0; i < 7; ++i) {
        s16 frame = closeValues[i];
        reset(13); D_00882060[0] = 0x80000010u; counterAfterGetter = frame;
        CHECK(func_00282250((u8 *)17, 13) == (frame >= 7));
        CHECK(getterCalls == 2 && visibleCalls == 1 && arrowCalls == 2);
        CHECK(backgroundCalls == (frame <= 7)); CHECK(sineCalls == (frame <= 7 ? 2u : 1u));
        CHECK(D_00882066[0] == (frame >= 7 ? 0 : frame));
        CHECK(D_00882060[0] == (frame >= 7 ? 0x80000000u : 0x80000010u)); checkSentinels();
    }
    for (unsigned change = 0; change < 2; ++change) {
        reset(11); D_00882060[0] = 0x80000008u; D_00882066[0] = 0x7fff;
        if (change) counterAfterDraw = 10;
        CHECK(func_00282250((u8 *)17, 11) == (s32)change);
        CHECK(backgroundCalls == 1 && getterCalls == 2 && sineCalls == 1);
        CHECK(D_00882066[0] == (change ? 0 : -32768));
        CHECK(D_00882060[0] == (change ? 0x80000000u : 0x80000008u)); checkSentinels();
    }
    native32_text("message-choice contracts passed\n"); return 0;
}
