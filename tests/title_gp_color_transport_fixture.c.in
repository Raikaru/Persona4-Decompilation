#include "type.h"
typedef s32 s128 __attribute__((vector_size(16)));
static u32 scenario;
#define CHECK(c) do { if (!(c)) native32_failure(__LINE__,scenario,#c); } while(0)
@TYPES@
@GP_DECLS@
static Code45RenderState D_00712490[6];
static f32 D_008872F8_abs[1],camera[0x90/4];
static s32 rectangle[4],saved[6];
static u32 word,drawWord,gets,sets,skies,draws,mode,cameraQueries;
static u8 *expectedColor;
static u32 load_word(const void *p) { u32 v;memcpy(&v,p,4);return v; }
static s32 func_00457120(void) {
    CHECK(cameraQueries==0);++cameraQueries;drawWord=word^0x01000000U;
    memcpy(expectedColor,&drawWord,4);return (s32)camera;
}
static void get_state(s32 state,void *p) {
    CHECK(gets<6&&gets==sets&&skies==0&&draws==0&&state==D_00712490[gets].state);*(s32 *)p=saved[gets++];
}
static void set_state(s32 state,s32 value) {
    if(sets<6) { CHECK(gets==sets+1&&skies==0&&draws==0&&state==D_00712490[sets].state&&value==D_00712490[sets].val); }
    else if(sets==6) { CHECK(gets==6&&skies==0&&draws==0&&state==1&&value==0); }
    else { CHECK(sets<13&&gets==6&&skies==2&&draws==1&&state==D_00712490[sets-7].state&&value==saved[sets-7]); }
    ++sets;
}
static void (*D_00887304[])(s32,void *)={get_state};
static void (*D_00887300[])(s32,s32)={set_state};
static void RpSkyRenderStateSet(s32 state,s32 value) {
    CHECK(gets==6&&sets==7&&skies<2&&draws==0&&state==(skies?3:2)&&value==(skies?0x717FB:0x44));++skies;
}
static void draw(s32 primitive,f32 *v,s32 count) {
    CHECK(primitive==4&&count==4&&gets==6&&sets==7&&skies==2&&draws==0&&cameraQueries==1);
    for(u32 i=0;i<4;++i) {
        CHECK(v[i*16]==(mode?((i&2)?640.0f:0.0f):(f32)(rectangle[0]+((i&1)?rectangle[2]:0))));
        CHECK(v[i*16+1]==(mode?((i&1)?448.0f:0.0f):(f32)(rectangle[1]+((i&2)?rectangle[3]:0))));
        CHECK(v[i*16+2]==D_008872F8_abs[0]&&v[i*16+6]==1.0f/camera[0x80/4]);
        for(u32 c=0;c<4;++c)CHECK(v[i*16+8+c]==(f32)((drawWord>>(8*c))&255));
        /* Fullscreen retail intentionally leaves other vertex words unwritten.
           Do not read those unspecified words just to broaden this fixture. */
    }
    ++draws;
}
static void (*D_00887310[])(s32,f32 *,s32)={draw};
@PROTOTYPE@
@PROVIDERS@
@CALLERS@
typedef struct { void (*call)(void);u32 fullscreen; } Site;
static const Site sites[]={ @SITES@ };
static void exercise(void) {
    @GP_SETUP@
    for(u32 i=0;i<6;++i) { D_00712490[i].state=(s32)i+10;D_00712490[i].val=(s32)i+100;saved[i]=(s32)i-100; }
    rectangle[0]=-17;rectangle[1]=29;rectangle[2]=640;rectangle[3]=448;
    camera[0x80/4]=2.0f;D_008872F8_abs[0]=128.0f;
    for(u32 i=0;i<6;++i) {
        ++scenario;gets=sets=skies=draws=cameraQueries=0;mode=sites[i].fullscreen;
        sites[i].call();CHECK(gets==6&&sets==13&&skies==2&&draws==1&&cameraQueries==1);
        @GP_CHECKS@
    }
}
int main(void) {
    static const u32 special[]={0,0x80000000U,0x7FC12345U,0x7F800001U,0xFFC12345U,0xFF800001U,0x7F800000U,0xFFFFFFFFU,0xFF800000U,1,0x80000001U,0x007FFFFFU,0x807FFFFFU,0x00800000U,0x80800000U};
    for(u32 channel=0;channel<4;++channel)for(u32 byte=0;byte<256;++byte) {
        word=(0x00123BA5U&~(255U<<(8*channel)))|(byte<<(8*channel));exercise();
    }
    for(u32 i=0;i<sizeof(special)/sizeof(special[0]);++i) { word=special[i];exercise(); }
    CHECK(scenario==6234);native32_text("6234 GP color/provider cases passed\n");return 0;
}
