  menu->x=18.25f;menu->y=-7.5f;menu->rows[0].x=-3.0f;menu->rows[0].y=4.25f;
  *(s16 *)(storage+0x36)=7;*(s16 *)(storage+0x4e)=1;*(s16 *)(storage+0x52)=0;
