            CHECK(packet.initFunc==(BtlPacketFunc)func_00197d50&&packet.updateFunc==func_00197d70&&packet.destroyFunc==(BtlPacketFunc)func_00197f30);
            for(u32 i=20;i<32;++i)CHECK(work.bytes[i]==0xA5);
        }
    }
