#include "type.h"
#define M2C_FIELD(expr, type_ptr, offset) (*(type_ptr)((u8 *)(expr) + (offset)))
static u32 scenario,site,draws,mode,sines,conversionCalls,subgraphCalls,pairCases;
#define CHECK(c) do { if (!(c)) native32_failure(__LINE__,scenario,#c); } while(0)
static f32 fGpffff8094,fGpffff8170,fGpffff80bc=1.0f,fGpffff82a0=1.0f;
static u32 state[64];
static u8 resource[16];
static u32 alphaExpected;
static f32 scaleInput,expectedScale,rawAlpha,firstSine,secondSine;
static s32 expectedPair,frame;
static f32 from_bits(u32 bits) {f32 v;memcpy(&v,&bits,4);return v;}
static u32 bits_of(f32 value) {u32 bits;memcpy(&bits,&value,4);return bits;}
static u32 integer_word(f32 value) {
    u32 bits=bits_of(value),mag,mantissa=(bits&0x7fffffU)|0x800000U;
    s32 exponent=(s32)((bits>>23)&255)-127;
    if(exponent<0)mag=0;else if(exponent<=23)mag=mantissa>>(23-exponent);else mag=mantissa<<(exponent-23);
    return bits>>31?0U-mag:mag;
}
static s32 signed_pair(f32 product) {u32 word=integer_word(product)&65535U;return word&32768U?-(s32)(65536U-word):(s32)word;}
static f32 sinf(f32 angle) {
    CHECK(mode==1&&sines<2);
    f32 expected;
    if(sines==0)expected=(fGpffff8094*(f32)frame)/225.0f;
    else {s32 phase=frame>=136?frame-135:0;expected=(fGpffff8094*(f32)phase)/90.0f;}
    CHECK(bits_of(angle)==bits_of(expected));
    ++sines;
    if(sines==1)return firstSine;
    /* An opaque second call may overwrite boundary storage, not the saved f32 return. */
    firstSine=99.0f;
