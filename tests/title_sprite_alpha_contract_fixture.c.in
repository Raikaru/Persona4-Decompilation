s32 func_0025f3f0(f32 x,f32 y,f32 z,s32 rgb,u8 alpha,s32 index,s32 offset,u8 *object,s32 flag) {
    record(x,y,z,rgb,alpha,index,offset,object,flag,0,0,0,0,0,0);return 0;
