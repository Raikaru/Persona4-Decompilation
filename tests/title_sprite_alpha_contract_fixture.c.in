}
int main(void) {
    static void (*const cases[10])(f32)={@SITE_FUNCTIONS@};
    static const u32 mantissas[]={0,1,2,0x3fffffU,0x400000U,0x7ffffdU,0x7ffffeU,0x7fffffU};
    static const s32 samples[9]={-16,-12,-5,-1,0,1,5,12,16};
    fGpffff8094=from_bits(0x3fc90fdb);fGpffff8170=from_bits(0x3f19999a);
    state[15]=(u32)resource;
    for(u32 exponent=0;exponent<=158;++exponent)for(u32 m=0;m<8;++m)for(u32 sign=0;sign<2;++sign) {
        if(sign&&exponent==158&&mantissas[m]!=0)continue;
        f32 value=from_bits((sign<<31)|(exponent<<23)|mantissas[m]);
        alphaExpected=integer_word(value)&255U;
        scaleInput=expectedScale=(f32)((s32)(scenario%257)-128)/16.0f;
        expectedPair=signed_pair(137.0f*scaleInput);
        for(site=0;site<10;++site) {draws=0;++scenario;cases[site](value);}
    }
