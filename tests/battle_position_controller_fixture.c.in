static void initialize(u32 mode,u32 special) {
    ++scenario; memset(&battle,0,sizeof(battle));memset(&formationData,0,sizeof(formationData));memset(&descriptor,0,sizeof(descriptor));memset(&actionData,0,sizeof(actionData));memset(&alternateAction,0,sizeof(alternateAction));
    memset(units,0,sizeof(units));memset(data,0,sizeof(data));memset(packets,0,sizeof(packets));
    memset(dead,0,sizeof(dead));memset(status,0,sizeof(status));memset(lowHp,0,sizeof(lowHp));memset(setPosCalls,0,sizeof(setPosCalls));memset(setRotCalls,0,sizeof(setRotCalls));memset(skillBits,0,sizeof(skillBits));memset(accessoryBits,0,sizeof(accessoryBits));memset(buffs,0,sizeof(buffs));
    readiness=packetCount=submitCount=setupCalls=fadeCalls=cutsceneCalls=selectedAction=groupCalls=prepareCalls=helpers=0; selectionClass=4;frames=20;encounter=0;eventState=0;
    iGpffffb414=(s32)formationData.bytes;putptr(battle.bytes+0xc68,descriptor.bytes);put16(descriptor.bytes+8,1);putptr(battle.bytes+0x170,actionData.bytes);putptr(actionData.bytes+0x30,units[0].bytes);putptr(alternateAction.bytes+0x30,units[2].bytes);put32(battle.bytes+0xdd4,123);
    putptr(battle.bytes+0x178,units[0].bytes);putptr(battle.bytes+0x180,units[2].bytes);putptr(units[0].bytes+0xa6c,units[1].bytes);put16(battle.bytes+0x1a,mode);put32(battle.bytes+0xc,special?0x20000000:0);battle.bytes[0xc64]=2;
    actorCenter=(RwV3d){1000.0f,90.0f,0.0f};groupCenter=(RwV3d){0.0f,80.0f,0.0f};
    formationPos[0]=(RwV3d){1000.0f,10.0f,0.0f};formationPos[1]=(RwV3d){2000.0f,20.0f,0.0f};formationPos[2]=(RwV3d){-100.0f,37.0f,0.0f};
    for(u32 i=0;i<3;++i){putptr(units[i].bytes+0xa64,data[i].bytes);put16(units[i].bytes+0x94,72+i);put16(units[i].bytes+0x96,70);putf(units[i].bytes+8,37.0f);put16(data[i].bytes,0xffff);put16(data[i].bytes+8,999);}
}
/* State5 creates at least one fresh enemy before special continuation.
 * The real proof binds authenticated resources and queue lifetimes; this is
 * only the executable fixture boundary, never a replacement proof. */
static s32 retained_height_precondition(void) {
    return readiness != 0 || !(*(u32 *)(battle.bytes+0xc)&0x20000000) ||
        *(u8 **)(battle.bytes+0x180) != 0;
}
static void run(void) { CHECK(retained_height_precondition());CHECK(func_001b2380()==6);CHECK(packetCount==submitCount && setupCalls==1);CHECK(count(PK_CAMERA)==1);for(u32 i=0;i<2;++i)CHECK(*(u16 *)data[i].bytes==0xf3ff);if(*(u8 **)(battle.bytes+0x180))CHECK(*(u16 *)data[2].bytes==0xf3ff); }
static RwV3d actual_pos(u32 i) { return *(RwV3d *)(units[i].bytes+4); }
static void normal(void) {
    initialize(0,0);run();vec_eq(actual_pos(0),(RwV3d){1500,10,0});vec_eq(actual_pos(1),(RwV3d){1500,20,0});
    CHECK(prepareCalls==3 && setRotCalls[0]==1 && setRotCalls[1]==1 && setRotCalls[2]==1 && groupCalls==3);CHECK(count(PK_MOVE)==2 && count(PK_ROTATE)==2 && count(PK_ANIM)==2);
    for(u32 i=0;i<2;++i){Packet *m=find(PK_MOVE,i),*r=find(PK_ROTATE,i),*a=find(PK_ANIM,i);CHECK(m->queue==1 && r->queue==1 && a->queue==1);CHECK(*(u64 *)((u8 *)r->words+8)==*(u64 *)((u8 *)m->words+0x58));CHECK(*(u64 *)((u8 *)a->words+8)==*(u64 *)((u8 *)m->words+0x58));CHECK(*(u16 *)((u8 *)a->words+0x48)==4);}
}
static void run_scenarios(void) {
    initialize(0,0);readiness=0x10000;CHECK(func_001b2380()==0 && setupCalls==0 && packetCount==0);
    normal();
    initialize(1,0);formationPos[1]=(RwV3d){1000,20,1000};run();vec_eq(actual_pos(1),(RwV3d){1000,20,500});
    initialize(0,0);selectionClass=0x104;run();CHECK(count(PK_ANIM)==1); /* s16, never s8 */
    initialize(2,0);run();vec_eq(actual_pos(0),(RwV3d){1300,10,0});vec_eq(actual_pos(1),(RwV3d){1700,20,0});CHECK(count(PK_TOWARD)==1 && count(PK_ANIM)==2);
    for(u32 i=0;i<2;++i){Packet *a=find(PK_ANIM,i),*m=find(PK_MOVE,i),*r=find(PK_ROTATE,i);CHECK(*(s16 *)((u8 *)a->words+0x4a)==12);CHECK(*(u64 *)((u8 *)m->words+8)==*(u64 *)((u8 *)a->words+0x58));CHECK(*(u64 *)((u8 *)r->words+8)==*(u64 *)((u8 *)m->words+0x58));}
    initialize(2,0);formationPos[1].x=200;frames=8;run();vec_eq(actual_pos(1),(RwV3d){200,20,0});CHECK(*(s16 *)((u8 *)find(PK_ANIM,0)->words+0x4a)==0);
    initialize(2,0);formationPos[1].x=300;frames=-1;run();vec_eq(actual_pos(1),(RwV3d){120,20,0});CHECK(*(u16 *)((u8 *)find(PK_ANIM,0)->words+0x4a)==65527);
    /* Full-width signed provider values are converted to an unsigned frame
     * count before the branch; check both sides of the exact delay boundary. */
    { static const s16 frameCases[] = {0,1,8,9,10,32767,-32768,-1};
      for(u32 n=0;n<sizeof(frameCases)/sizeof(frameCases[0]);++n) {
        initialize(2,0);frames=frameCases[n];run();
        u16 full=(u16)frames;u16 expected=full>8?full-8:0;
        for(u32 i=0;i<2;++i)CHECK(*(u16 *)((u8 *)find(PK_ANIM,i)->words+0x4a)==expected);
      }
    }
    initialize(2,0);put32(formationData.bytes+0x18,0x200);run();CHECK(count(PK_TOWARD)==0 && count(PK_MOVE)==2);vec_eq(actual_pos(0),(RwV3d){1500,10,0});
    initialize(0,1);status[1]=1;run();CHECK(prepareCalls==1 && setRotCalls[0]==0 && setRotCalls[1]==0 && setRotCalls[2]==1);CHECK(count(PK_POSE)==2 && count(PK_STATE)==1 && count(PK_MOVE)==1);vec_eq(find(PK_POSE,0)->vector,(RwV3d){100,10,0});vec_eq(find(PK_POSE,1)->vector,formationPos[1]);
    initialize(0,1);dead[0]=1;frames=-7;run();CHECK(count(PK_DELAY)==1 && count(PK_FADE_OUT)==1 && count(PK_FADE_IN)==1);CHECK(find(PK_DELAY,0)->queue==1 && find(PK_DELAY,0)->value==-7);vec_eq(actual_pos(0),(RwV3d){50,37,0});CHECK(status[0]&0x80000);CHECK(*(u16 *)(data[0].bytes+8)==0);
    initialize(7,0);skillBits[0]=2;accessoryBits[2]=4;run();CHECK(buffs[0]==5 && buffs[1]==5 && buffs[2]==0x110);CHECK(count(PK_MOVE)==0);
    initialize(7,0);put16(formationData.bytes+0x1c,0x8001);put16(formationData.bytes+0x1e,0x8002);put32(battle.bytes+0xc,0x100000);encounter=0x215;eventState=1;run();CHECK(*(u16 *)(battle.bytes+0xcd0)==0x8001 && *(u16 *)(battle.bytes+0xcd2)==0x8002 && *(u32 *)(battle.bytes+0xcdc)==1);CHECK((*(u32 *)(battle.bytes+0xc)&0x102000)==0x2000 && cutsceneCalls==3 && fadeCalls==1);
    /* Preserve the old seeded-only witness as out-of-domain evidence:
     * initialize(0,1);putptr(battle.bytes+0x180,0);dead[0]=1;run();
     * vec_eq(actual_pos(0),(RwV3d){50,0,0});
     * That defined guarded-C fallback relied on position.y = 0.0f; it was
     * never a retail claim. Reject this fabricated special/empty/dead-first
     * state before calling the accepted unseeded production function. */
    initialize(0,1);putptr(battle.bytes+0x180,0);dead[0]=1;
    CHECK(!retained_height_precondition());CHECK(setupCalls==0 && packetCount==0);
    /* Script/direct single-wave descriptors can have no enemy row; they do
     * not set the continuation bit. Dead units then never consume position Y. */
    initialize(0,0);putptr(battle.bytes+0x180,0);dead[0]=1;run();
    CHECK(setPosCalls[0]==0 && count(PK_DELAY)==1);
    /* A live normal unit receives all position components from formation. */
    initialize(0,0);putptr(battle.bytes+0x180,0);run();
    vec_eq(actual_pos(0),(RwV3d){1500,10,0});
    initialize(7,0);selectedAction=2;units[2].bytes[0xa2]=1;run();
    { static const s32 ids[] = {0x20b,0x215,0x20a,0x20c,0x214,0x216};
      for(u32 n=0;n<sizeof(ids)/sizeof(ids[0]);++n) {
        initialize(7,0);encounter=ids[n];run();
        CHECK(cutsceneCalls==((ids[n]==0x20b||ids[n]==0x215)?2:1));
        CHECK(fadeCalls==1);
      }
    }
    initialize(0,0);battle.bytes[0xc64]=1;run();CHECK(count(PK_MOVE)==0);
}
int main(void) { run_scenarios();native32_text("battle-position scenarios passed\n");return 0; }
