static void func_001ee250(u8 *arg0, u8 *arg1) { (void)unit_index(arg0); CHECK(!arg1); ++prepareCalls; }
static void func_001ec1c0(u8 *rotation, u8 *from, u8 *to) {
    RwV3d a = *(RwV3d *)from, b = *(RwV3d *)to;
    CHECK(a.x == a.x && a.y == a.y && a.z == a.z && b.x == b.x && b.y == b.y && b.z == b.z);
    *(RtQuat *)rotation = expectedRotation; ++helpers;
}
static void btlUnitSetPos(BtlUnit *unit, const RwV3d *position) {
    u32 i=unit_index(unit); memcpy(units[i].bytes + 4, position, sizeof(*position)); ++setPosCalls[i];
}
static void btlUnitSetRot(BtlUnit *unit, const RtQuat *rotation) { quat_eq(*rotation, expectedRotation); ++setRotCalls[unit_index(unit)]; }
static f32 RwV3dNormalize(RwV3d *out, const RwV3d *in) {
    f32 square=in->x*in->x + in->y*in->y + in->z*in->z;
    f32 length=square>1.0f?square:1.0f;
    for(u32 i=0;i<32;++i)length=(length+square/length)*0.5f;
    CHECK(length > 0.0f); RwV3d result = {in->x/length,in->y/length,in->z/length}; *out=result; return length;
}
static BtlPacket *btlUnitCreateMovePacket(BtlUnit *unit, const RwV3d *targetPos, f32 speed, u32 flags) {
    CHECK(speed == fGpffff82cc && flags == 8); Packet *p=allocate(PK_MOVE,unit); p->vector=*targetPos; vec_eq(p->vector,formationPos[p->unit]); return (BtlPacket *)p->words;
}
static BtlPacket *btlUnitCreateRotatePacket(BtlUnit *unit, const RwV3d *direction, u32 flags) {
    CHECK(flags==0); Packet *p=allocate(PK_ROTATE,unit); p->vector=*direction; vec_eq(p->vector,expectedDirection); return (BtlPacket *)p->words;
}
static BtlPacket *btlUnitCreateRotateTowardUnitPacket(BtlUnit *unit, BtlUnit *targetUnit, u32 flags) {
    CHECK(flags==2 && (void *)targetUnit == units[0].bytes); return (BtlPacket *)allocate(PK_TOWARD,unit)->words;
}
static BtlPacket *btlUnitCreateAnimPacket(BtlUnit *unit, s16 id, u16 blendFrameCount, f32 speed, u16 mode) {
    CHECK(speed==1.0f); CHECK((id==0xb && blendFrameCount==0 && mode==0) || (id==0x11 && blendFrameCount==4 && mode==0) || (id==0x13 && blendFrameCount==0 && mode==2));
    Packet *p=allocate(PK_ANIM,unit); p->value=id; return (BtlPacket *)p->words;
}
static s16 func_00199500(u8 *arg0, u16 arg1, f32 arg2) { (void)unit_index(arg0); CHECK((arg1==0x13 || arg1==0xb) && arg2==1.0f); return frames; }
static BtlPacket *func_0019aa70(BtlUnit *unit, s16 value) { CHECK(value==frames); Packet *p=allocate(PK_DELAY,unit);p->value=value;return (BtlPacket *)p->words; }
static BtlPacket *func_0019a0c0(BtlUnit *unit, s16 value) { CHECK(value==0);return (BtlPacket *)allocate(PK_STATE,unit)->words; }
BtlPacket *func_001f8330(BtlUnit *unit) { return (BtlPacket *)allocate(PK_FADE_OUT,unit)->words; }
BtlPacket *func_001f82b0(BtlUnit *unit) { return (BtlPacket *)allocate(PK_FADE_IN,unit)->words; }
u8 *func_00195730(u8 *unit,u8 *position,u8 *rotation,u8 *color) {
    CHECK(!color);Packet *p=allocate(PK_POSE,unit);p->vector=*(RwV3d *)position;p->quaternion=*(RtQuat *)rotation;quat_eq(p->quaternion,expectedRotation);return (u8 *)p->words;
}
static BtlPacket *btlCameraCreateSetStatePacket(BtlAction *action,u16 state) { CHECK((void *)action == actionData.bytes && state==2); return (BtlPacket *)allocate(PK_CAMERA,0)->words; }
static u32 datCalcIsDead(s32 arg0,s32 arg1) { CHECK(!arg1);return dead[data_index(arg0)]; }
static u32 datCalcChkBadStatus(s32 arg0,u32 arg1) { return (status[data_index(arg0)] & arg1) != 0; }
static u32 datCalcIsLowHp(s32 unit) { return lowHp[data_index(unit)]; }
static u32 datCalcSetBadStatus(s32 unit,u32 badStatus) { CHECK(badStatus==0x80000);status[data_index(unit)] |= badStatus;return 1; }
static void datCalcSetHp(s32 arg0,u16 arg1) { CHECK(!arg1);put16(data[data_index(arg0)].bytes + 8,arg1); }
static void func_00198dd0(u8 *unit,u16 frame) { (void)unit_index(unit);CHECK(frame==0); }
static void func_0019d040(u8 *arg0) { (void)unit_index(arg0); }
static s32 func_00243e90(u8 *arg0) { (void)data_index((s32)arg0);return selectionClass; }
static s32 func_00232730(u8 *arg0,s32 arg1) { u32 i=data_index((s32)arg0);if(arg1>=0x213 && arg1<=0x215)return (skillBits[i]>>(arg1-0x213))&1;CHECK(arg1>=0x202 && arg1<=0x204);return (skillBits[i]>>(arg1-0x202+3))&1; }
static s32 func_00232950(u8 *arg0,s32 arg1) { CHECK(arg1>=0x53 && arg1<=0x55);return (accessoryBits[data_index((s32)arg0)]>>(arg1-0x53))&1; }
static void func_00234830(u8 *arg0,s32 arg1,s64 arg2) { CHECK(arg2==1);buffs[data_index((s32)arg0)] |= arg1; }
static void func_0021d440(s32 task) { CHECK(task==123);++cutsceneCalls; }
static s32 func_001ef9a0(void) { return encounter; }
static void func_002aaaa0(void) { ++cutsceneCalls; }
static void btlFadeStartImmediate(void) { ++fadeCalls; }
