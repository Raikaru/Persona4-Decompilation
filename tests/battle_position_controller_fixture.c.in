static f32 absolute(f32 v) { return v < 0 ? -v : v; }
static void vec_eq(RwV3d a, RwV3d b) { CHECK(absolute(a.x-b.x)<0.001f && absolute(a.y-b.y)<0.001f && absolute(a.z-b.z)<0.001f); }
static void quat_eq(RtQuat a, RtQuat b) { vec_eq(a.imag, b.imag); CHECK(a.real == b.real); }
static u64 uid(u32 n) { return 0xFEDCBA9800000000ULL + n; }
enum { PK_CAMERA, PK_ANIM, PK_MOVE, PK_ROTATE, PK_TOWARD, PK_DELAY, PK_STATE, PK_FADE_OUT, PK_FADE_IN, PK_POSE };
static Packet *allocate(u32 kind, const void *unit) {
    CHECK(packetCount < 64);
    Packet *p = &packets[packetCount++];
    memset(p, 0, sizeof(*p)); p->kind = kind; p->unit = unit ? unit_index(unit) : 99;
    return p;
}
static Packet *find(u32 kind, u32 ordinal) {
    for (u32 i=0; i<packetCount; ++i) if (packets[i].kind == kind && ordinal-- == 0) return &packets[i];
    CHECK(0); return 0;
}
static u32 count(u32 kind) { u32 n=0; for (u32 i=0;i<packetCount;++i) n += packets[i].kind == kind; return n; }
