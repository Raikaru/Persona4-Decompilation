#include "type.h"
#define CHECK(c) do { if (!(c)) native32_failure(__LINE__, scenario, #c); } while (0)
static unsigned scenario, providerCalls;
typedef union { u64 alignment; u8 bytes[0xA0]; } Action;
static Action action, companion;
static u8 unit[4];
static s16 companionEnd;
static f32 fGpffff8128=0.35f;
/* A recording timing boundary with the real signed-halfword result contract.
   Existing timing-provider suites execute the unchanged provider separately. */
s16 func_00199500(u8 *input,u16 motion,f32 rate) {
    CHECK(input==unit && motion==0x1A && rate==1.0f);
    ++providerCalls;return companionEnd;
}
static s32 signedHalfword(s32 value) {
    u32 low=(u32)value&0xFFFFu;
    return low<0x8000u ? (s32)low : (s32)low-65536;
}
static void runCase(s32 start,s32 end,u32 flags,u32 paired,u32 seed) {
    s64 *arg0=(s64 *)action.bytes;
    s32 var_23=start,temp_2_4=end;
    s32 sp258=(flags&1) ? 1 : 0,sp254=(flags&2) ? -1 : 0,sp1B0=paired ? 7 : 0;
    s32 timingAdjustment,var_18,temp_2_5,sp280,sp270,temp_2_17;
    companionEnd=(s16)(seed^0xA55A);
    providerCalls=0;
    @CALCULATION@
    /* Independent integer oracle for this bounded source contract: while the
       product is below the cap (difference <75), nearest-binary32 0.35*d
       truncates to floor(7*d/20); every larger difference is capped to25.
       No C floating expression from the implementation is reused here. */
    s32 difference=end-start;
    s32 adjustment=difference<=0 ? 0 : difference>=75 ? 25 : difference*7/20;
    s32 expected=signedHalfword(start+adjustment+(flags ? 8 : 0)+(paired ? 12 : 0));
    CHECK(temp_2_17==expected && var_18==expected);
    CHECK(providerCalls==paired);
    s32 companionDifference=(s32)companionEnd-4-start;
    CHECK(sp280==(paired && companionDifference>0 ? companionDifference : 0));
    CHECK(sp270==(paired && companionDifference<0 ? -companionDifference : 0));
    CHECK(*(u8 **)(action.bytes+0x88)==companion.bytes);
    CHECK(*(u8 **)(companion.bytes+0x30)==unit);
    ++scenario;
}
int main(void) {
    u32 factorBits;memcpy(&factorBits,&fGpffff8128,4);CHECK(factorBits==0x3EB33333u);
    *(u8 **)(action.bytes+0x88)=companion.bytes;
    *(u8 **)(companion.bytes+0x30)=unit;
    for (u32 phase=0;phase<3;++phase)
     for (u32 value=0;value<65536;++value)
      for (u32 flags=0;flags<4;++flags)
       for (u32 paired=0;paired<2;++paired) {
        s32 start=phase==0 ? -32768 : (s32)value-32768;
        s32 end=phase==0 ? (s32)value-32768 : phase==1 ? 32767 : -32768;
        runCase(start,end,flags,paired,value);
       }
    native32_text("timing_clamp_cases=");native32_number(scenario);native32_text("\n");return 0;
}
