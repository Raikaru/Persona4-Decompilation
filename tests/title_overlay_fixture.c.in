@PROVIDER@
@HELPER@
static void invoke_actual_call(u32 word) {
    switch (site) {
        @CALLS@
        default: CHECK(0);
    }
}
int main(void) {
    /* Every byte channel takes every value; other channels carry unrelated
       bits, including floating NaN representations. The actual calls address
       color storage as bytes and must not numerically convert those bits. */
    for (site = 0; site < 15; ++site)
        for (u32 channel = 0; channel < 4; ++channel)
            for (u32 value = 0; value < 256; ++value)
                for (mutation = 0; mutation < 2; ++mutation) {
                    u32 word = (0x7FC13BA5u & ~(255u << (channel * 8))) | (value << (channel * 8));
                    allocations = draws = queueCalls = notices = 0;
                    memset(&storage, 0xCC, sizeof(storage));
                    memset(node, 0xA5, sizeof(node));
                    invoke_actual_call(word);
                    CHECK(allocations == 1 && draws == 1 && queueCalls == 0 && notices == 1);
                    for (u32 i = 0; i < 8; ++i) CHECK(storage.bytes[i] == 0xCC);
                    for (u32 i = 0x24; i < sizeof(storage.bytes); ++i) CHECK(storage.bytes[i] == 0xCC);
                    for (u32 i = 0; i < sizeof(node); ++i) CHECK(node[i] == 0xA5);
                    ++scenario;
                }
    native32_text("title_overlay_cases="); native32_number(scenario); native32_text("\n");
    return 0;
}
