#include "type.h"
typedef struct { f32 v0, v1, v2, v3; } Float4;
typedef struct { u8 b0, b1, b2, b3; } Byte4;
typedef struct { u8 c0, c1, c2, c3; } __attribute__((aligned(4))) TitleColor;
#define CHECK(c) do { if (!(c)) native32_failure(__LINE__, scenario, #c); } while (0)
static unsigned scenario, site, mutation, allocations, draws, queueCalls, notices;
static u8 *inputColor;
static u32 expectedColor;
static u8 D_0063EE50[1], parentStorage[4];
typedef union { u32 alignment; u8 bytes[0x2C]; } PacketStorage;
static PacketStorage storage;
static u8 node[0x20] __attribute__((aligned(4)));
static void prepare_color(void *out, u32 word) {
    inputColor = out;
    memcpy(out, &word, 4);
    expectedColor = mutation ? word ^ 0x5AA53CC3u : word;
}
static void *allocate_packet(size_t count, size_t size, u32 flags) {
    CHECK(count == 1 && size == 0x1C && flags == 0x40000);
    CHECK(notices == 1 && allocations == 0);
    if (mutation) {
        u32 word;
        memcpy(&word, inputColor, 4);
        word ^= 0x5AA53CC3u;
        memcpy(inputColor, &word, 4);
    }
    ++allocations;
    return storage.bytes + 8;
}
void *(*D_008873F4[])(size_t, size_t, u32) = {allocate_packet};
void func_0044ea90(const void *file, s32 line) {
    CHECK(file == D_0063EE50 && line == 0x91 && notices == 0);
    ++notices;
}
u8 *func_00460990(void) { ++queueCalls; return node; }
void func_00460ac0(void *parent, void *item) {
    (void)parent; (void)item;
    /* All 15 actual calls are immediate. Passing any parent changes behavior. */
    CHECK(0);
}
void func_002aabf0(void *parent, void *packet) {
    CHECK(parent == 0 && packet == storage.bytes + 8 && allocations == 1 && draws == 0);
    s32 bounds[4]; u32 color, flags; f32 depth;
    memcpy(bounds, packet, 16);
    memcpy(&depth, (u8 *)packet + 0x10, 4);
    memcpy(&color, (u8 *)packet + 0x14, 4);
    memcpy(&flags, (u8 *)packet + 0x18, 4);
    CHECK(bounds[0] == 0 && bounds[1] == 0 && bounds[2] == 640);
    CHECK(bounds[3] == (site == 14 ? 480 : 448));
    CHECK(depth == (site == 1 || site == 14 ? 0.0f : 65535.0f));
    CHECK(color == expectedColor && flags == 0x12);
