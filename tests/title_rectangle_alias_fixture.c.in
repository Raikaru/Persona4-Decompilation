#include "type.h"
typedef s32 s128 __attribute__((vector_size(16)));
static u32 scenario;
#define CHECK(c) do { if (!(c)) native32_failure(__LINE__,scenario,#c); } while(0)
#define M2C_FIELD(expr,type,offset) (*(type)((u8 *)(expr)+(offset)))
@TYPES@
_Static_assert(sizeof(TitleRectangleWords)==16,"rectangle extent");
_Static_assert(__builtin_offsetof(TitleRectangleWords,words)==0,"word alias");
static s128 D_005E5650,D_005E5660;
static Code45RenderState D_00712490[6];
static f32 camera[0x90/4],D_008872F8_abs[1];
static union { u64 align;u8 bytes[0x90]; } task;
static s32 inputFrame,finalFrame,expected[2][4],saved[6];
static u32 phase,gets,sets,skies,draws;
static u8 color[4];
static s32 func_00457120(void) { return (s32)camera; }
static void get_state(s32 state,void *out) {
    CHECK(phase<2&&gets<6&&state==D_00712490[gets].state&&gets==sets&&skies==0&&draws==0);
    *(s32 *)out=saved[gets++];
}
static void set_state(s32 state,s32 value) {
    if(sets<6) { CHECK(gets==sets+1&&skies==0&&draws==0&&state==D_00712490[sets].state&&value==D_00712490[sets].val); }
    else if(sets==6) { CHECK(gets==6&&skies==0&&draws==0&&state==1&&value==0); }
    else { CHECK(sets<13&&gets==6&&skies==2&&draws==1&&state==D_00712490[sets-7].state&&value==saved[sets-7]); }
    ++sets;if(sets==13) { ++phase;gets=sets=skies=draws=0; }
}
static void (*D_00887304[])(s32,void *)={get_state};
static void (*D_00887300[])(s32,s32)={set_state};
static void RpSkyRenderStateSet(s32 state,s32 value) {
    CHECK(phase<2&&gets==6&&sets==7&&draws==0&&skies<2&&state==(skies?3:2)&&value==(skies?0x717FB:0x44));++skies;
}
static void draw(s32 primitive,f32 *vertices,s32 count) {
    CHECK(phase<2&&primitive==4&&count==4&&gets==6&&sets==7&&skies==2&&draws==0);
    for(u32 i=0;i<4;++i)for(u32 w=0;w<16;++w) {
        f32 value=0.0f;
        if(w==0)value=(f32)(expected[phase][0]+((i&1)?expected[phase][2]:0));
        if(w==1)value=(f32)(expected[phase][1]+((i&2)?expected[phase][3]:0));
        if(w==2)value=D_008872F8_abs[0];
        if(w==6)value=1.0f/camera[0x80/4];
        if(w>=8&&w<=11)value=(f32)color[w-8];
        CHECK(vertices[i*16+w]==value);
    }
    ++draws;
}
static void (*D_00887310[])(s32,f32 *,s32)={draw};
@PROVIDERS@
static void exercise(void) {
    @GUARDS@
    @ALIASES@
    @LOCALS@
    u8 *temp_20=task.bytes;
    @INITIALIZE@
    CHECK(sizeof(sp520)==16&&sizeof(sp510)==16&&sizeof(sp590)==16&&sizeof(sp6BC)==4);
    memcpy(&sp6BC,color,4);*(s32 *)(task.bytes+0x88)=inputFrame;
    @COUNTER@
    CHECK(*(s32 *)(task.bytes+0x88)==finalFrame);
    @BLOCK@
    CHECK(phase==2&&gets==0&&sets==0&&skies==0&&draws==0);
    CHECK(memcmp(&sp520,expected[0],16)==0&&memcmp(&sp510,expected[1],16)==0&&memcmp(&sp590,expected[1],16)==0);
    CHECK(memcmp(&sp6BC,color,4)==0);
    /* A fractional retail intermediate must not be rounded before either Y conversion. */
    if((20-finalFrame)%10!=0)CHECK(temp_f20!=(f32)(s32)temp_f20);
    CHECK((s32)temp_f20==(21*(20-finalFrame))/10);
    @GUARD_CHECKS@
    @UNALIAS@
}
int main(void) {
    for(u32 seed=0;seed<65536;++seed) {
        s32 first[4]={(s32)(seed%101)-50,999,(s32)(seed%641),42};
        s32 second[4]={(s32)(seed%83)-41,-999,(s32)(seed%607),43};
        ++scenario;inputFrame=(seed&0x8000)?(s32)seed-65536:(s32)seed;
        finalFrame=inputFrame+1;if(finalFrame>=20)finalFrame=20;
        memcpy(&D_005E5650,first,16);memcpy(&D_005E5660,second,16);memcpy(expected[0],first,16);memcpy(expected[1],second,16);
        expected[0][1]=-(21*(20-finalFrame))/10;expected[1][1]=406+(21*(20-finalFrame))/10;
        for(u32 i=0;i<4;++i)color[i]=(u8)(seed+i*37);
        for(u32 i=0;i<6;++i) { D_00712490[i].state=(s32)i+10;D_00712490[i].val=(s32)(seed+i*11);saved[i]=(s32)(0xCAFE0000U^(seed+i*7)); }
        camera[0x80/4]=2.0f;D_008872F8_abs[0]=128.0f;phase=gets=sets=skies=draws=0;
        exercise();CHECK(memcmp(&D_005E5650,first,16)==0&&memcmp(&D_005E5660,second,16)==0);
    }
    CHECK(scenario==65536);native32_text("65536 rectangle snapshot/provider cases passed\n");return 0;
}
