static u8 *arena,*queue;
static unsigned scenario,allocated,preexisting,firstKind,length;
static s32 stateWord,valueWord;
u8 *iGpffffba98;
u8 iGpffffaf70;
#define CHECK(x) do {if(!(x))native32_failure(__LINE__,scenario,#x);}while(0)
static u32 word(const u8 *p,unsigned offset){u32 x;memcpy(&x,p+offset,4);return x;}
static u16 half(const u8 *p,unsigned offset){u16 x;memcpy(&x,p+offset,2);return x;}
static u8 *link(u8 *p,unsigned offset){return *(u8 **)(p+offset);}
static void putlink(u8 *p,unsigned offset,u8 *value){*(u8 **)(p+offset)=value;}
static u8 *allocate(u8 *context,s32 flags){CHECK(context==iGpffffba98 && flags==0x41002 && allocated<10);return arena+64*allocated++;}
u8 *(*D_008873F8[])(u8 *,s32)={allocate};
void func_0046d730(u8 *file,s32 line){native32_failure(line,scenario,"unexpected ordering-table assertion");}
static u8 *raw_allocate(void){
 u32 args[6]={0,4096,3,0x22,0xffffffff,0},address;
 __asm__ volatile("int $0x80":"=a"(address):"0"(90),"b"(args):"memory");
 CHECK(address<0xfffff001u);return(u8*)address;
}
static void raw_release(u8 *p){s32 result;__asm__ volatile("int $0x80":"=a"(result):"0"(91),"b"(p),"c"(4096):"memory");CHECK(result==0);}
int main(void){
 static const s32 words[]={(-2147483647-1),-32768,-1,0,1,32767,2147483647};
 arena=raw_allocate();queue=raw_allocate();iGpffffba98=raw_allocate();
 for(preexisting=0;preexisting<2;++preexisting)for(firstKind=0;firstKind<2;++firstKind)
 for(unsigned s=0;s<7;++s)for(unsigned v=0;v<7;++v)for(unsigned n=0;n<2;++n){
  ++scenario;allocated=0;length=n?10:1;stateWord=words[s];valueWord=words[v];
  memset(arena,0xa5,4096);memset(queue,0,4096);
  if(preexisting){memset(arena+0xf00,0,0x30);putlink(queue,0,arena+0xf00);putlink(queue,4,arena+0xf00);}
  for(unsigned i=0;i<length;++i){
   u8 *result=((firstKind+i)&1)?func_00460c70(queue,stateWord,valueWord):func_00460b60(queue,stateWord,valueWord);
   CHECK(result==arena+i*64 && allocated==i+1 && link(queue,4)==result);
  }
  u8 *node=link(queue,0);
  if(preexisting){CHECK(node==arena+0xf00);node=link(node,0);}
  for(unsigned i=0;i<length;++i){
   CHECK(node==arena+i*64 && half(node,0x18)==2+((firstKind+i)&1));
   CHECK(word(node,0x1c)==(u32)stateWord && word(node,0x20)==(u32)valueWord);
   for(unsigned j=0;j<0x30;++j){if(j<4 ||(j>=0x18&&j<0x1a)||(j>=0x1c&&j<0x24))continue;CHECK(node[j]==0);}
   for(unsigned j=0x30;j<64;++j)CHECK(node[j]==0xa5);
   node=link(node,0);
  }
  CHECK(node==0 && link(queue,4)==arena+(length-1)*64);
 }
 CHECK(scenario==392);raw_release(arena);raw_release(queue);raw_release(iGpffffba98);
 native32_text("SDK state constructors: 392 scenarios passed\n");return 0;
}
