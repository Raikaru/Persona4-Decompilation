_Static_assert(sizeof(D_00881808_t)==0x20,"manager stride");
_Static_assert(__builtin_offsetof(MessageObject,work)==0x114,"work offset");
_Static_assert(sizeof(ProcedureWork)==0x1c,"work extent");
_Static_assert(__builtin_offsetof(ProcedureWork,arguments)==4,"argument offset");
_Static_assert(__builtin_offsetof(ProcedureWork,phase)==0x14,"phase offset");
_Static_assert(__builtin_offsetof(ProcedureWork,userdata)==0x18,"userdata offset");
_Static_assert(__builtin_offsetof(MessageObject,canary)==0x130,"message extent");
