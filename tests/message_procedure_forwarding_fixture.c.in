s32 func_00277840(s32 handle){CHECK(handle==expectedHandle);++getterCalls;return actualProcedureWork(handle);}
static s32 callback(s32 handle,s32 phase){CHECK(handle==expectedHandle&&phase==expectedPhase);++callbackCalls;return callbackResult;}
static void reset(s32 handle){
