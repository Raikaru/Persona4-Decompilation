typedef struct {Procedure callback;s32 arguments[4];s32 phase;void *userdata;} ProcedureWork;
typedef struct {u8 prefix[0x114];ProcedureWork work;u32 canary;} MessageObject;
static MessageObject objects[64],expected[64];
static s32 words[64][2];
D_00881808_t D_00881808[64];
