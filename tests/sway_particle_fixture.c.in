}
static void check_spawn_calls(unsigned count,unsigned global,unsigned mode,unsigned budgetRandom){
    unsigned cursor=0;
    CHECK(matrixCalls==1&&attributeCalls==count&&!trailCalls);
    CHECK(floatCalls==count*(mode==2?10:(mode==1?12:11))+budgetRandom);
    CHECK(integerCalls==count*(mode==1)&&sineCalls==count);
    CHECK(multiplyCalls==count&&normalizeCalls==count&&transformCalls==global*count*2&&addCalls==global*count);
    expect_fragment(&cursor,"B");if(budgetRandom)expect_fragment(&cursor,"F");
    for(unsigned i=0;i<count;i++){
        if(global)expect_fragment(&cursor,"T");
        expect_fragment(&cursor,"FFN");if(global)expect_fragment(&cursor,"T");
        expect_fragment(&cursor,"FFFFFFSFM");if(global)expect_fragment(&cursor,"+");
        expect_fragment(&cursor,"F");if(mode!=2)expect_fragment(&cursor,"F");
        if(mode==1)expect_fragment(&cursor,"FR");expect_fragment(&cursor,"A");
    }
    CHECK(cursor==providerCount);
}
