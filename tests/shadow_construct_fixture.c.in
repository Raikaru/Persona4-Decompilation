/* Execute the unmodified production constructor with real bounds/model bodies.
 * External allocation, graphics and queue boundaries check their complete inputs.
 * Trigonometric samples exercise geometry and angle sequencing, not libm accuracy. */
#include "type.h"
#include "rw_atomic_internal.h"
#include "field_shadow_internal.h"
#include "Kosaka/k_clump_internal.h"

static unsigned cases;
#define CHECK(x) do { if (!(x)) native32_failure(__LINE__, cases, #x); } while (0)
typedef union { u64 alignment; u8 bytes[0x800]; } Storage;
@@CONSTRUCT_TYPES@@
@@MATH_DATA@@

static Storage task, context, inner, models[2], clump, shadow, geometry_store, material_store;
static Storage morph_store, atomic_store, frame_store, triangles_store, vertices_store, colours_store, nodes[2];
static Storage context_expected, models_expected[2], shadow_expected, material_expected, morph_expected;
static Storage triangles_expected, vertices_expected, colours_expected, nodes_expected[2], atomic_expected;
static Storage sphere_atomics[3];
static RwSphere bounds[3], geometry_bound;
static unsigned bound_count, bound_queries, math_sines, math_cosines, triangles_seen, materials_seen;
static unsigned ready_calls, node_count, appended, changed, initial_mode;
static s32 ready_result;
static u8 *ctx, *model, *geometry, *material, *morph, *atomic, *frame;
static char events[256], expected_events[256];
static unsigned event_count, expected_event_count;
static RwV3d expected_position;
u8 D_00794330[64];
FieldColor_0017 iGpffff9f48;

static void put32(u8 *where, s32 value) { memcpy(where, &value, 4); }
static void put16(u8 *where, u16 value) { memcpy(where, &value, 2); }
static void putf(u8 *where, f32 value) { memcpy(where, &value, 4); }
static void putp(u8 *where, const void *value) { memcpy(where, &value, 4); }
static s32 get32(const u8 *where) { s32 value; memcpy(&value, where, 4); return value; }
static void *getp(const u8 *where) { void *value; memcpy(&value, where, 4); return value; }
static void note(char tag) { CHECK(event_count < sizeof(events)); events[event_count++] = tag; }
static void expect(char tag) { CHECK(expected_event_count < sizeof(expected_events)); expected_events[expected_event_count++] = tag; }

s32 func_004782b0(u8 *value) {
    CHECK(value == model); ++ready_calls; note('r');
    if (changed) put32(ctx, 5);
    return ready_result;
}
RwSphere *func_003bfae0(void *value) {
    for (unsigned i = 0; i < bound_count; ++i) {
        if (value == sphere_atomics[i].bytes + 0x20) { ++bound_queries; return &bounds[i]; }
    }
    CHECK(0); return NULL;
}
@@BOUNDS_CALLBACK@@

void *func_003bff30(void *value, KClumpCallback callback, void *data) {
    const u8 zeros[24] = {0};
    CHECK(value == clump.bytes + 0x20 && callback == func_00179130);
    CHECK(memcmp(data, zeros, sizeof(zeros)) == 0); note('b');
    for (unsigned i = 0; i < bound_count; ++i)
        CHECK(callback(sphere_atomics[i].bytes + 0x20, data) == sphere_atomics[i].bytes + 0x20);
    return value;
}
@@MODEL_GETTERS@@
@@MODEL_FLAG@@

u8 *func_003c4140(void) {
    note('m');
    if (changed) {
        iGpffff9f48.red ^= 0x81; iGpffff9f48.green ^= 0x23;
        iGpffff9f48.blue ^= 0x54; iGpffff9f48.alpha ^= 0xA5;
    }
    return material;
}
struct RpGeometry *func_003c2630(s32 vertices, s32 triangles, u32 format) {
    CHECK(vertices == 34 && triangles == 32 && format == 0x4A);
    CHECK(getp(shadow.bytes + 0x28) == material);
    CHECK(memcmp(material + 4, material_expected.bytes + 0x24, 4) == 0);
    putp(geometry + 0x2C, triangles_store.bytes + 0x20);
    putp(geometry + 0x30, colours_store.bytes + 0x20);
    putp(geometry + 0x5C, morph);
    putp(morph + 0x14, vertices_store.bytes + 0x20);
    note('g'); return (struct RpGeometry *)geometry;
}
const struct RpGeometry *func_003c2130(const struct RpGeometry *value, struct RpTriangle *triangle,
                                     u16 a, u16 b, u16 c) {
    u8 *record = (u8 *)triangle;
    CHECK((u8 *)value == geometry && triangles_seen < 32);
    CHECK(record == triangles_store.bytes + 0x20 + triangles_seen * 8);
    CHECK(a == 0 && b == triangles_seen + 2 && c == triangles_seen + 1);
    put16(record, a); put16(record + 2, b); put16(record + 4, c);
    ++triangles_seen; note('t'); return value;
}
struct RpGeometry *func_003c2150(struct RpGeometry *value, struct RpTriangle *triangle,
                                struct RpMaterial *mat) {
    CHECK((u8 *)value == geometry && (u8 *)mat == material);
    CHECK((u8 *)triangle == triangles_store.bytes + 0x20 + materials_seen * 8);
    CHECK(materials_seen + 1 == triangles_seen);
    put16((u8 *)triangle + 6, 0); ++materials_seen; note('p'); return value;
}
f32 cosf(f32 angle) {
    CHECK(math_sines < 33 && angle == fixture_angles[math_sines]);
    CHECK(math_sines == math_cosines); note('s');
    return fixture_sines[math_sines++];
}
f32 sinf(f32 angle) {
    CHECK(math_cosines < 33 && angle == fixture_angles[math_cosines]);
    CHECK(math_cosines + 1 == math_sines); note('c');
    return fixture_cosines[math_cosines++];
}
struct RpGeometry *func_003c22f0(struct RpGeometry *value) {
    CHECK((u8 *)value == geometry && math_sines == 33 && math_cosines == 33);
    CHECK(memcmp(&triangles_store, &triangles_expected, sizeof(Storage)) == 0);
    CHECK(memcmp(&vertices_store, &vertices_expected, sizeof(Storage)) == 0);
    CHECK(memcmp(&colours_store, &colours_expected, sizeof(Storage)) == 0);
    note('u'); return value;
}
const struct RpMorphTarget *func_003c1d40(const struct RpMorphTarget *value, RwSphere *sphere) {
    CHECK((u8 *)value == morph); *sphere = geometry_bound; note('h'); return value;
}
u8 *func_003c00e0(void) {
    CHECK(memcmp(morph + 4, &geometry_bound, sizeof(geometry_bound)) == 0);
    note('a'); return atomic;
}
struct RpAtomic *func_003c0210(struct RpAtomic *value, struct RpGeometry *shape, u32 flags) {
    CHECK((u8 *)value == atomic && (u8 *)shape == geometry && flags == 0);
    CHECK(getp(shadow.bytes + 0x24) == atomic); note('o'); return value;
}
s32 func_003c2a80(struct RpGeometry *shape) { CHECK((u8 *)shape == geometry); note('d'); return 1; }
struct RwFrame *func_003e9320(void) { note('f'); return (struct RwFrame *)frame; }
struct RpAtomic *RpAtomicSetFrame(struct RpAtomic *value, struct RwFrame *target) {
    CHECK((u8 *)value == atomic && (u8 *)target == frame);
    putp(atomic + 4, frame); note('l'); return value;
}
struct RwFrame *func_003e9df0(struct RwFrame *target) {
    CHECK((u8 *)target == frame && getp(atomic + 4) == frame); note('i'); return target;
}
void func_0017a700(u8 *pool, u8 *data) { (void)pool; (void)data; }
void func_0017a8d0(u8 *pool, u8 *data) { (void)pool; (void)data; }
void func_0017aae0(u8 *pool, u8 *data) { (void)pool; (void)data; }
void func_0017abd0(u8 *pool, u8 *data) { (void)pool; (void)data; }
u8 *func_00460990(void) { CHECK(node_count < 2); note('q'); return nodes[node_count++].bytes + 0x20; }
void func_00460ac0(u8 *pool, u8 *command) {
    void (*callback)(u8 *, u8 *) = NULL;
    CHECK(pool == D_00794330 && command == nodes[appended].bytes + 0x20);
    CHECK(getp(command + 0x10) == ctx);
    memcpy(&callback, command + 8, 4);
    if (initial_mode == 1) CHECK(callback == func_0017a700);
    if (initial_mode == 3) CHECK(callback == func_0017abd0);
    if (initial_mode == 4) CHECK(callback == (appended ? func_0017aae0 : func_0017a8d0));
    ++appended; note('n');
    if (changed && initial_mode == 4 && appended == 1) putp(ctx + 0x10, models[1].bytes + 0x20);
}
void func_00479100(void *pool, u8 *value) {
    CHECK(pool == D_00794330 && value == (changed ? models[1].bytes + 0x20 : model)); note('v');
}
u8 *func_003e9c10(u8 *target, const f32 *position, s32 mode) {
    CHECK(target == frame && mode == 0 && memcmp(position, &expected_position, 12) == 0);
    note('x'); return target;
}

@@CONSTRUCT_BODY@@

static void expected_node(unsigned slot, void (*callback)(u8 *, u8 *)) {
    putp(nodes_expected[slot].bytes + 0x28, (void *)callback);
    putp(nodes_expected[slot].bytes + 0x30, ctx);
}
static void expected_fan(f32 radius, u16 tag) {
    f32 height = (tag >> 10) == 1 ? 5.0f : 2.0f;
    u8 *verts = vertices_expected.bytes + 0x20;
    u8 *colours = colours_expected.bytes + 0x20;
    putf(verts, 0.0f); putf(verts + 4, height); putf(verts + 8, 0.0f);
    for (unsigned i = 0; i < 33; ++i) {
        u8 *vertex = verts + (i + 1) * 12;
        putf(vertex, radius * fixture_sines[i]);
        putf(vertex + 4, height);
        putf(vertex + 8, radius * fixture_cosines[i]);
    }
    for (unsigned i = 0; i < 32; ++i) {
        u8 *triangle = triangles_expected.bytes + 0x20 + i * 8;
        put16(triangle, 0); put16(triangle + 2, (u16)(i + 2));
        put16(triangle + 4, (u16)(i + 1)); put16(triangle + 6, 0);
        expect('t'); expect('p');
    }
    for (unsigned i = 0; i < 33; ++i) { expect('s'); expect('c'); }
    memset(colours, 0, 34 * 4);
    colours[3] = (tag >> 10) == 1 && (tag & 1023) >= 100 ? 255 : 150;
}

static void exercise(s32 state, u16 mode, u32 flags, u16 entity_class, unsigned pause,
                     unsigned ready, unsigned mutation, u16 tag) {
    const f32 radii[4] = {0.0f, 0.5f, 18.75f, 120.0f};
    unsigned active = (flags & 2) && (entity_class != 3 || (flags & 0x10000000)) && !pause;
    unsigned build = active && state == 0 && (mode == 3 || mode == 4) && ready;
    s32 expected_result = active && state == 2 ? -1 : 0;
    f32 radius = radii[cases % 4];
    Storage task_before, inner_before;
    ctx = context.bytes + 0x20; model = models[0].bytes + 0x20;
    geometry = geometry_store.bytes + 0x20; material = material_store.bytes + 0x20;
    morph = morph_store.bytes + 0x20; atomic = atomic_store.bytes + 0x20; frame = frame_store.bytes + 0x20;
    Storage *stores[] = {&task, &context, &inner, &models[0], &models[1], &clump, &shadow, &geometry_store,
        &material_store, &morph_store, &atomic_store, &frame_store, &triangles_store, &vertices_store,
        &colours_store, &nodes[0], &nodes[1]};
    for (unsigned i = 0; i < sizeof(stores) / sizeof(stores[0]); ++i) memset(stores[i], 0xA5, sizeof(Storage));
    putp(task.bytes + 0x58, ctx); putp(ctx + 0xC, inner.bytes + 0x20);
    put16(inner.bytes + 0x20, (u16)(entity_class << 10)); put32(inner.bytes + 0x48, (s32)flags);
    put32(ctx, state); put32(ctx + 4, (s32)pause); put16(ctx + 8, tag); put16(ctx + 0xA, mode);
    putp(ctx + 0x10, model); putp(ctx + 0x50, shadow.bytes + 0x20);
    putf(shadow.bytes + 0x20, radius); putp(shadow.bytes + 0x24, atomic); putp(atomic + 4, frame);
    putp(model + 0xDC, clump.bytes + 0x20);
    expected_position.x = -91.25f + (f32)(cases % 9);
    expected_position.y = 27.5f; expected_position.z = -0.0f;
    memcpy(model + 0x30, &expected_position, 12);
    iGpffff9f48.red = (u8)cases; iGpffff9f48.green = (u8)(cases ^ 0xF0);
    iGpffff9f48.blue = (u8)(cases * 37); iGpffff9f48.alpha = (u8)(255 - cases);
    bound_count = (cases / 16) % 4;
    for (unsigned i = 0; i < 3; ++i) {
        bounds[i].center.x = (f32)(100 + i);
        bounds[i].center.y = -9.75f + (f32)i * 6.5f;
        bounds[i].center.z = 22.25f - (f32)i;
        bounds[i].radius = cases & 1 ? (f32)(2 + i * 4) : (i == 0 ? 4.0f : i == 1 ? 3.0f : 6.0f);
    }
    geometry_bound.center.x = -1.25f; geometry_bound.center.y = 3.5f;
    geometry_bound.center.z = -0.0f; geometry_bound.radius = radius + 2.0f;
    context_expected = context; models_expected[0] = models[0]; models_expected[1] = models[1];
    shadow_expected = shadow; material_expected = material_store; morph_expected = morph_store;
    triangles_expected = triangles_store; vertices_expected = vertices_store; colours_expected = colours_store;
    nodes_expected[0] = nodes[0]; nodes_expected[1] = nodes[1]; atomic_expected = atomic_store;
    task_before = task; inner_before = inner;
    changed = mutation; initial_mode = mode; ready_result = ready ? -7 : 0;
    ready_calls = bound_queries = math_sines = math_cosines = triangles_seen = materials_seen = 0;
    node_count = appended = event_count = expected_event_count = 0;
    if (active && state == 0) {
        if (mode == 0) put32(context_expected.bytes + 0x20, 1);
        if (mode >= 1 && mode <= 4) {
            expect('r');
            if (changed) put32(context_expected.bytes + 0x20, 5);
            if (ready) {
                put32(context_expected.bytes + 0x20, changed ? 6 : 1);
                if (mode == 1) {
                    RwV3d center = {0,0,0}; f32 total = 0; void *winner = NULL;
                    expect('b');
                    for (unsigned i = 0; i < bound_count; ++i) {
                        if (bounds[i].radius > total) { center = bounds[i].center; winner = sphere_atomics[i].bytes + 0x20; }
                        total += bounds[i].radius;
                    }
                    putp(context_expected.bytes + 0x34, winner); putf(context_expected.bytes + 0x38, 90.0f);
                    center.x = center.z = 0.0f; memcpy(context_expected.bytes + 0x4C, &center, 12);
                    putf(context_expected.bytes + 0x58, total);
                } else if (mode == 2) {
                    put32(models_expected[0].bytes + 0xF8, get32(model + 0xD8) | 1);
                } else {
                    FieldColor_0017 expected_colour = iGpffff9f48;
                    if (changed) { expected_colour.red ^= 0x81; expected_colour.green ^= 0x23;
                        expected_colour.blue ^= 0x54; expected_colour.alpha ^= 0xA5; }
                    putp(shadow_expected.bytes + 0x28, material);
                    memcpy(material_expected.bytes + 0x24, &expected_colour, 4);
                    putp(morph_expected.bytes + 0x34, vertices_store.bytes + 0x20);
                    memcpy(morph_expected.bytes + 0x24, &geometry_bound, 16);
                    expect('m'); expect('g'); expected_fan(radius, tag);
                    const char suffix[] = "uhaodfli";
                    for (unsigned i = 0; i < sizeof(suffix) - 1; ++i) expect(suffix[i]);
                }
            }
        }
    } else if (active && state == 1) {
        if (mode == 1 || mode == 3) {
            if (mode == 3) expect('x');
            expected_node(0, mode == 1 ? func_0017a700 : func_0017abd0);
            expect('q'); expect('n');
        } else if (mode == 4) {
            expected_node(0, func_0017a8d0); expected_node(1, func_0017aae0);
            expect('q'); expect('n'); expect('v'); expect('q'); expect('n');
            if (changed) putp(context_expected.bytes + 0x30, models[1].bytes + 0x20);
        }
    }
    CHECK(func_0017acc0(task.bytes + 0x20) == expected_result);
    CHECK(event_count == expected_event_count && memcmp(events, expected_events, event_count) == 0);
    CHECK(ready_calls == (active && state == 0 && mode >= 1 && mode <= 4));
    CHECK(memcmp(&context, &context_expected, sizeof(Storage)) == 0);
    CHECK(memcmp(&models[0], &models_expected[0], sizeof(Storage)) == 0);
    CHECK(memcmp(&models[1], &models_expected[1], sizeof(Storage)) == 0);
    CHECK(memcmp(&shadow, &shadow_expected, sizeof(Storage)) == 0);
    CHECK(memcmp(&material_store, &material_expected, sizeof(Storage)) == 0);
    CHECK(memcmp(&morph_store, &morph_expected, sizeof(Storage)) == 0);
    CHECK(memcmp(&atomic_store, &atomic_expected, sizeof(Storage)) == 0);
    CHECK(memcmp(&nodes, &nodes_expected, sizeof(nodes)) == 0);
    CHECK(memcmp(&task, &task_before, sizeof(Storage)) == 0 && memcmp(&inner, &inner_before, sizeof(Storage)) == 0);
    CHECK(memcmp(&triangles_store, &triangles_expected, sizeof(Storage)) == 0);
    CHECK(memcmp(&vertices_store, &vertices_expected, sizeof(Storage)) == 0);
    CHECK(memcmp(&colours_store, &colours_expected, sizeof(Storage)) == 0);
    CHECK(math_sines == (build ? 33u : 0u) && math_cosines == (build ? 33u : 0u));
    ++cases;
}
int main(void) {
    const s32 states[4] = {-1,0,1,2};
    const u32 flags[3] = {0,2,0x10000002};
    const u16 classes[3] = {0,1,3};
    const u16 tags[4] = {0,1024+99,1024+100,2048+25};
    for (unsigned s = 0; s < 4; ++s)
    for (u16 mode = 0; mode < 6; ++mode)
    for (unsigned f = 0; f < 3; ++f)
    for (unsigned c = 0; c < 3; ++c)
    for (unsigned pause = 0; pause < 2; ++pause)
    for (unsigned ready = 0; ready < 2; ++ready)
    for (unsigned mutate = 0; mutate < 2; ++mutate)
    for (unsigned tag = 0; tag < 4; ++tag)
        exercise(states[s], mode, flags[f], classes[c], pause, ready, mutate, tags[tag]);
    CHECK(cases == 6912);
    native32_number(cases); native32_text(" shadow construction cases passed\n");
    return 0;
}
