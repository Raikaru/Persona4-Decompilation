# Copyrighted retail inputs and extracted bytes: supply your own.
/orig/
/image.bin
/SLUS_217.82
/*.iso

# Scratch probes from codegen experiments; build/ is already ignored.
/.probe/

# Permuter/probe candidate dumps. These are written to the repo ROOT by
# tools/permute_*.py and by hand during matching probes; 15 of them were
# committed by accident before this rule existed.
/cand.json
/cand_*.json
/cands.json
/cands_*.json

# Generated split/build output. The leading slash on /build/ only anchors the
# ROOT build directory: a lane that wrote to a nested path once committed
# source/Persona4-Decompilation/build/.../*.o straight past it, so ignore a
# build directory at ANY depth and object files outright.
/build/
build/
*.o
/assets/
/asm/*.s
/asm/*.o
# asm/nonmatchings/ is HAND-AUTHORED INCLUDE_ASM fallback code, not splat output.
# It must stay tracked or a fresh checkout cannot reproduce the build.
!/asm/nonmatchings/
/asm/data/
/asm/chunks/
/include/macro.inc
/undefined_funcs_auto.txt
/undefined_syms_auto.txt

# Local tool configuration and caches.
/tools/verify_config.local.json
/tools/build_config.local.json
/tools/vendor/m2c/
*.m2c
/tools/__pycache__/
__pycache__/
/.vscode/
*.pyc
# cloned on first use by tools/permute_ast.py; upstream, not ours
tools/decomp-permuter/
